#!/usr/bin/env bash
# The repo's git-native pre-commit gate. Activated per-clone with:
#
#     git config core.hooksPath tools/githooks
#
# It is a per-clone LOCAL setting, so a fresh clone starts ungated until that
# line runs.
#
# WHAT THIS USED TO BE, AND WHY IT IS SMALL NOW
# ---------------------------------------------
# This file was ~1,300 lines: an explicit suite map plus a filename convention
# that ran, on every commit, whichever of 32 `test-*.sh` suites and 14 mutation
# harnesses covered the staged files. Every one of those suites, and every
# subject they gated, belonged to the AGENT TIER — which no longer lives in
# this repository (it is a separate repo, installed by ./bootstrap-agents.sh;
# see README.md). Its gate went with it, unchanged, and still runs there.
#
# Leaving the old body here as "inert" was NOT an option, and that is a
# measured claim rather than a tidiness argument. The suite map keys on staged
# paths, and three of its entries name files that STAY public — `zsh/.zshenv`,
# `tmux/tmux.conf`, `mac.upgrade.sh` — mapped to suites that are now absent. A
# map entry pointing at a missing suite BLOCKS by design (it means the gate
# itself has rotted), so the old hook did not go quiet after the split: it
# refused every commit touching those files. Reproduced on the pruned tree
# before this rewrite:
#
#     pre-commit: FAIL — the EXPLICIT SUITE MAP names 2 file(s) that do not exist:
#         tmux/tmux.conf -> agents/bin/test-hall.sh
#         zsh/.zshenv    -> agents/lib/test-claude-identity-wrapper.sh
#     pre-commit: FAIL — agents/lib/mutate-tap-failover.sh is missing
#     pre-commit: BLOCKED.
#
# So this is a deliberate rewrite to what this repository can actually gate on
# its own: program configuration, and the shell scripts that install it.
#
# WHAT IT CHECKS
#   * every staged `*.sh` parses (`bash -n`). Cheap, and it is the failure that
#     costs the most here — these scripts run on a machine being provisioned,
#     often over a pipe to bash, where a syntax error lands halfway through.
#
# If a real test suite ever lands in this repo, add it below by name. Do not
# reintroduce a filename-convention mapping: the lesson of the old body is that
# a gate which cannot tell you it did not gate is the defect it exists to
# prevent, and a convention is exactly how that happens silently.

set -uo pipefail

ROOT=$(git rev-parse --show-toplevel) || exit 0

# git exports GIT_DIR / GIT_INDEX_FILE / GIT_PREFIX / … to its hooks, and those
# leak into every `git` a check might run. `--local-env-vars` is git's own list
# of exactly these, so this stays correct as git adds more.
unset $(git rev-parse --local-env-vars)

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

FAILED=0

while IFS= read -r f; do
  case "$f" in
    *.sh) ;;
    *) continue ;;
  esac
  [ -f "$ROOT/$f" ] || continue
  if ! bash -n "$ROOT/$f"; then
    echo "pre-commit: FAIL — $f is not valid bash" >&2
    FAILED=1
  fi
done <<< "$STAGED"

if [ "$FAILED" -ne 0 ]; then
  cat >&2 <<'EOF'

pre-commit: BLOCKED. A staged shell script does not parse. The failing file is
named above.

Fix it and commit again. Do NOT reach for --no-verify.
EOF
  exit 1
fi
exit 0
