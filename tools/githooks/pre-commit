#!/usr/bin/env bash
# The repo's git-native pre-commit gate. Activated per-clone with:
#
#     git config core.hooksPath tools/githooks
#
# WHY THIS EXISTS (dotfiles-jm1c). ~/dotfiles — the repo that HOLDS the fleet's
# harness — had no test runner of any kind: no core.hooksPath, no
# .git/hooks/pre-commit, no CI. Its 32 `test-*.sh` suites and
# `pre-bead-close.sh --selftest` ran only when a human typed them, and
# `pre-bead-close.sh` line 18 says "Run this after ANY edit to the verdict
# regexes below" — a human intending to run something is not a mechanism.
# A 13-mutant sweep on 2026-08-01 found three survivors against green suites;
# one was a LIVE false-accept in the pulse `done` gate (dotfiles-8aj5), and one
# was caught only by the `--selftest` nobody invoked. This is the caller.
#
# A RELATIVE core.hooksPath resolves against the top level of the working tree
# the commit is made in, so a worktree agent runs ITS OWN copy of this hook
# against ITS OWN files — not the main checkout's. (Same property ~/explore
# relies on; this file follows that repo's shape deliberately.)
#
# THE GATE KEYS ON THE TEST FILE AS WELL AS THE SCRIPT. Weakening a guard is
# frequently an edit to the test alone, and a script-only trigger walks
# straight past the highest-value failure mode.
#
# AND IT SAYS SO WHEN IT DOES NOT GATE (dotfiles-dijt). Suite selection is by
# filename convention, so a suite named for something other than its subject is
# invisible to it — and "no suite found" used to look exactly like "suite
# passed". Two mechanisms now: an explicit `mapped_suites_for()` for the
# off-name suites (a map entry pointing at a missing file BLOCKS — that is the
# gate breaking, not the repo), and a banner, printed FIRST and repeated last,
# naming every staged script that ran nothing.
#
# Everything here runs under BASH on purpose: `scrutiny_verdict_ok` ends in
# `grep -qv` over possibly-empty input, which exits 0 under zsh and 1 under
# bash — a zsh-run harness reports the no-verdict cases as ACCEPTED.

set -uo pipefail

ROOT=$(git rev-parse --show-toplevel) || exit 0

# git exports GIT_DIR / GIT_INDEX_FILE / GIT_PREFIX / … to its hooks, and those
# leak into every `git` the suites run — several of them build real repos and
# worktrees as fixtures, which then die on `.git/index: index file open failed:
# Not a directory`. Caught on the very first real commit through this gate:
# test-pre-commit-checks.sh was 69/69 by hand and 65/69 under `git commit`.
# `--local-env-vars` is git's own list of exactly these, so this stays correct
# as git adds more.
unset $(git rev-parse --local-env-vars)
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0
FAILED=0

SUITES=()
UNCOVERED=()
MAP_BROKEN=()
CUR_FILE=""
CUR_MAPPED=0

_push_suite() {
  local existing
  for existing in ${SUITES+"${SUITES[@]}"}; do [ "$existing" = "$1" ] && return; done
  SUITES+=("$1")
}

# Convention-derived (test-<n>.sh). A missing file here is a COVERAGE GAP in
# the repo, not a bug in this hook — reported loudly, but it does not block.
add_suite() {
  local s=$1
  if [ ! -f "$ROOT/$s" ]; then
    [ "$CUR_MAPPED" -eq 1 ] || UNCOVERED+=("$CUR_FILE   (convention wanted $s)")
    return
  fi
  _push_suite "$s"
}

# Explicit-map entry. A missing file here is a BUG IN THE GATE — someone
# renamed or deleted a suite the map still names — so it BLOCKS. The gate is
# the one thing in this repo that must not be allowed to degrade quietly.
add_mapped_suite() {
  local s=$1 f=$2
  if [ ! -f "$ROOT/$s" ]; then
    MAP_BROKEN+=("$f -> $s")
    return
  fi
  _push_suite "$s"
}

# --- THE EXPLICIT SUITE MAP (dotfiles-dijt) -------------------------------
# Name-derivation is the underlying fragility: a suite whose FILENAME does not
# match its subject is invisible to the convention, and nothing said so. Live
# instance — staging agents/hooks/session-start.sh derived
# agents/hooks/test/test-session-start.sh, which has never existed, so every
# edit to the fleet's session-start hook gated on NOTHING. Found 2026-08-01
# while landing dotfiles-1rj5 in that exact file: the merge-driver suite had to
# be run by hand and the commit went through ungated. A 2026-08-02 sweep of all
# four gated dirs found six more subjects in the same shape.
#
# Entries are ADDITIVE to the convention below, so a script that has both a
# test-<n>.sh and an off-name suite runs both.
mapped_suites_for() { # <staged path> -> newline-separated suite paths
  case "$1" in
    agents/hooks/session-start.sh)
      printf '%s\n' \
        agents/hooks/test/test-session-start-merge-driver.sh \
        agents/hooks/test/test-session-start-settings-symlink.sh \
        agents/hooks/test/test-session-start-symlink-triple.sh \
        agents/hooks/test/test-session-start-window.sh \
        agents/hooks/test/test-session-start-seat-identity.sh \
        agents/hooks/test/test-secret-alert.sh \
        agents/hooks/test/test-always-loaded-staleness.sh ;;
    # The WAKE-TIME IDENTITY composer (dotfiles-z10i) lives under agents/lib but
    # its only consumer is the session-start hook, and the properties that
    # matter — an unregistered window costs nothing and prints nothing — are
    # only observable through that hook. So it maps to the HOOK's suite rather
    # than asking for an agents/lib/test-seat-identity.sh that would test the
    # composer in isolation and miss the gate entirely. Same
    # name-the-consumer-with-the-producer argument as lib/portable.sh below.
    agents/lib/seat-identity.sh|agents/hooks/test/mutate-seat-identity.sh)
      printf '%s\n' agents/hooks/test/test-session-start-seat-identity.sh ;;
    agents/hooks/session-end.sh)
      printf '%s\n' agents/hooks/test/test-secret-alert.sh ;;
    agents/hooks/lib/always-loaded.sh|agents/hooks/stop-always-loaded-check.sh)
      printf '%s\n' agents/hooks/test/test-always-loaded-staleness.sh ;;
    # There is no test-pre-compact-observe.sh and there never was: the observer
    # ships WITH the Stop-hook guard it backs up, and cases 9-11 of that suite
    # drive this exact script. Before this entry, every edit to the PreCompact
    # backstop was gated on NOTHING while its coverage sat one file away — the
    # dotfiles-dijt shape, found again while landing dotfiles-it06.
    agents/hooks/pre-compact-observe.sh)
      printf '%s\n' agents/hooks/test/test-stop-context-guard.sh ;;
    # pre-compact.sh is the OTHER PreCompact hook (dotfiles-ygf8): it clears
    # stop-context-guard.sh's .fired/.nudged markers on every compaction — RE-ARM
    # path (b), the belt for the guard's own re-arm. No test-pre-compact.sh
    # exists or should: its one property worth testing (does it clear the right
    # markers) is exercised alongside the guard it backs up, same shape as
    # pre-compact-observe.sh above. Before this entry it fell through to the
    # convention, asked for a test-pre-compact.sh that has never existed, and
    # landed in the UNCOVERED banner instead of actually gating.
    agents/hooks/pre-compact.sh)
      printf '%s\n' agents/hooks/test/test-stop-context-guard.sh ;;
    agents/hooks/post-bash-beads-merge-check.sh)
      printf '%s\n' agents/hooks/test/test-beads-merge-check.sh ;;
    agents/hooks/pre-tool-use-require-isolation.sh)
      printf '%s\n' agents/hooks/test/test-require-isolation.sh ;;
    agents/hooks/pre-tool-use-worktree-guard.sh)
      printf '%s\n' agents/hooks/test/test-worktree-guard.sh ;;
    # lib/portable.sh HAS a test-portable.sh (the convention finds it), but its
    # whole reason to exist is the four guards that depend on it. Naming the
    # CONSUMERS alongside the producer is the point: an edit that makes
    # _p_realpath return an empty string still passes the shim's own suite while
    # turning the worktree guard into a fail-closed brick (dotfiles-5vz2).
    agents/hooks/lib/portable.sh)
      printf '%s\n' \
        agents/hooks/test/test-worktree-guard.sh \
        agents/hooks/test/test-stop-context-guard.sh \
        agents/hooks/test/test-pre-shared-tree-guard.sh \
        agents/hooks/test/test-always-loaded-staleness.sh ;;
    # There is no test-pulse-surface-queue.sh — the queue is covered by its
    # CONSUMER, which drives the real script rather than a stub. That is not an
    # accident of naming: the queue's P1 (dotfiles-sxsv) was in the command its
    # drain TYPES, which is only observable end to end, through a real stage and a
    # real drain into a recording injector. test-pulse-ledger-watch.sh does that.
    # It used to be TWO consumers — test-pulse-dispatch-remote.sh covered the
    # `remote` origin — but the remote dispatcher was retired with marketing-vps
    # (dotfiles-y3u8). The queue still HAS a `remote` origin and it is still the
    # default; what it no longer has is a producer, so the local suite is the
    # whole of its end-to-end coverage. Restore the second entry the day a remote
    # origin comes back.
    agents/scheduler/pulse-surface-queue.sh)
      printf '%s\n' \
        agents/scheduler/test-pulse-ledger-watch.sh ;;
    # seat-resolve.sh and handoff-path.sh are producer and consumer, and the
    # convention only finds each one's own test-<n>.sh. The seat guard that
    # handoff-path.sh gained (dotfiles-tzfr) is covered by test-seat-resolve.sh
    # — an edit that silently disarms it passes test-handoff-path.sh, because
    # the pre-seat cases are exactly the ones the guard must NOT disturb. Name
    # both directions, same argument as lib/portable.sh above.
    # The MOLT is a producer/consumer pair across two dirs (dotfiles-it06):
    # stop-context-guard.sh's instruction NAMES seat-molt.sh by resolved path,
    # and its suite asserts that path is executable — the mechanical form of
    # this repo's rule 2 (a documented example is executable). Moving or
    # renaming seat-molt.sh therefore breaks the guard's message, and only the
    # guard's suite can see it. Same argument as lib/portable.sh above: name the
    # consumer in the same change as the producer.
    agents/scheduler/seat-molt.sh)
      printf '%s\n' agents/hooks/test/test-stop-context-guard.sh ;;
    # pico-ports.manifest is DATA, and the convention loop below only maps
    # SCRIPTS to test-<n>.sh suites — so a hand-edit to the expected-listener
    # set (a duplicate, a stray word, a line deleted "because it was noisy")
    # had no commit-time gate at all. Same posture as the seats.yml arm at the
    # bottom of this file. Case 20 of the suite lints the real manifest.
    agents/scheduler/pico-ports.manifest)
      printf '%s\n' agents/scheduler/test-pico-health.sh ;;
    # demesne-sync.exclude is DATA in the same sense as pico-ports.manifest, and
    # it is the more dangerous of the two: every line is a hole in the cutover's
    # identity gate. Add a pattern that matches real brain content and the gate
    # reads IDENTICAL over content it never compared — a PASS, not a failure.
    # The convention loop maps scripts only, so without this arm a hand-edit to
    # the list would be gated on nothing. Case 15 lints the real file.
    agents/scheduler/demesne-sync.exclude)
      printf '%s\n' agents/scheduler/test-demesne-sync.sh ;;
    agents/lib/handoff-path.sh)
      printf '%s\n' agents/lib/test-seat-resolve.sh ;;
    # seat-resolve.sh has a THIRD consumer since dotfiles-sb6s: agents/bin/hall
    # reuses its roster dump and its lexicon-strip rather than growing a second
    # parser or a second glyph regex. So a change to either internal breaks the
    # court view, and only the hall's own suite can see it — the same
    # producer/consumer argument as lib/portable.sh above.
    # A FOURTH consumer since dotfiles-z10i: seat-identity.sh composes the wake
    # header out of _seat_dump + seat_self_name, and leans on the opt-in
    # $_SEAT_DUMP_CACHE memo added there. A memo that silently stops memoizing
    # triples the header's cost with every suite still green, and only the
    # hook's own suite exercises that path.
    agents/lib/seat-resolve.sh)
      printf '%s\n' agents/lib/test-handoff-path.sh agents/bin/test-hall.sh \
        agents/hooks/test/test-session-start-seat-identity.sh ;;
    # tmux.conf is not a script and matches no convention arm, but it holds the
    # HALL block — the popup binding and the attach-default hook — and
    # test-hall.sh EXECUTES those bytes as committed on a fixture server (this
    # repo's rule 2). Editing the block without running the suite is exactly the
    # dotfiles-dijt shape: gated on nothing, silently.
    tmux/tmux.conf)
      printf '%s\n' agents/bin/test-hall.sh ;;
    # Not under agents/, so no convention arm below reaches it — and its bug was
    # an ORDERING bug (dotfiles-v26x), the kind an unrun suite is written for.
    mac.upgrade.sh)
      printf '%s\n' agents/hooks/test/test-mac-upgrade-brew-order.sh ;;
    # A Python skill helper with a pytest suite: it matches no convention arm
    # below, so before this entry every edit to the /dream helper — the loop
    # that reads the whole fleet's transcripts and files beads from them — was
    # gated on NOTHING, silently (the dotfiles-dijt shape). run-suite.sh is a
    # bash wrapper so the gate can call it like every other suite; the mutation
    # harness is named alongside it because the fleet-scope guards
    # (denylist, caps, per-repo filing, --dry-run) all fail SILENTLY, which is
    # precisely the class a green suite does not cover. The TEST FILES are
    # triggers too: weakening a guard is usually an edit to its test.
    agents/skills/dream/dream.py|agents/skills/dream/tests/test_dream_fleet.py|agents/skills/dream/tests/mutate-fleet-guards.sh)
      printf '%s\n' \
        agents/skills/dream/tests/run-suite.sh \
        agents/skills/dream/tests/mutate-fleet-guards.sh \
        agents/lib/test-seat-history.sh ;;
    # The LAURELS chain (dotfiles-qnfk) spans three dirs, and the property the
    # spec cares about — a placement lands in the history AND the ledger AND
    # the brief, or in none of them — is only observable END TO END. Each
    # file's own suite passes while the chain is broken, which is the
    # dotfiles-dijt shape one level up: three green suites, one silent defect.
    # So every link names the shared suite. dream.py's arm above does too.
    agents/lib/seat-history.sh|agents/lib/mutate-laurels.sh|agents/lib/validate-seats.py|agents/scheduler/seneschal-gather.py)
      printf '%s\n' agents/lib/test-seat-history.sh ;;
    agents/skills/dream/tests/test_dream.py|agents/skills/dream/tests/test_dream_seams.py|agents/skills/dream/tests/_dream_helpers.py|agents/skills/dream/tests/conftest.py|agents/skills/dream/tests/run-suite.sh)
      printf '%s\n' agents/skills/dream/tests/run-suite.sh ;;
    # agents/bin/ is NOT one of the four convention-covered dirs (hooks,
    # scheduler, lib, doclint) -- the switch-case arm below never reaches it,
    # so without this entry every edit to the process reaper (dotfiles-415c,
    # a script that decides WHICH PROCESSES TO KILL, unattended, on a timer)
    # would be gated on NOTHING (the dotfiles-dijt shape). Name both files so
    # editing either the script or its suite triggers the suite.
    agents/bin/orphan-reaper.sh|agents/bin/test-orphan-reaper.sh)
      printf '%s\n' agents/bin/test-orphan-reaper.sh ;;
    # marshal.conf is DATA in the same sense as pico-ports.manifest and
    # demesne-sync.exclude — and it is the most expensive of the three to get
    # wrong: every number in it is a knob on what an unattended 01:07 loop
    # SPENDS overnight (the weekly cap, Zig's daytime reserve, the safety
    # margin, the degraded floor, the opt-in repo list). The convention loop
    # maps scripts only, so without this arm a hand-edit here would be gated on
    # nothing. The suite reads the committed file's grammar and drives the
    # budget against a fixture db.
    agents/scheduler/marshal.conf)
      printf '%s\n' agents/scheduler/test-marshal-drain.sh ;;
    # THE MOLT THRESHOLD PAIR (dotfiles-9060): one constant in
    # agents/lib/molt-thresholds.sh, two consumers in two different dirs. The
    # convention finds each consumer's OWN suite, and each of those stays green
    # while the pair silently drifts apart — a marshal molting twice as often as
    # intended, or never. Only the binding suite sees it, so both consumers name
    # it. (molt-thresholds.sh itself reaches its suite through the convention.)
    agents/hooks/stop-context-guard.sh|agents/scheduler/marshal-drain.sh)
      printf '%s\n' agents/lib/test-molt-thresholds.sh ;;
  esac
}

# --- map each staged script to the suite that covers it -------------------
# Convention (see agents/hooks/test/test-worktree-guard.sh): a script <n>.sh
# is covered by test-<n>.sh, in a test/ subdir under agents/hooks and beside
# the script under agents/scheduler and agents/lib.
while IFS= read -r f; do
  [ -z "$f" ] && continue
  CUR_FILE=$f
  CUR_MAPPED=0
  while IFS= read -r m; do
    [ -z "$m" ] && continue
    CUR_MAPPED=1
    add_mapped_suite "$m" "$f"
  done <<< "$(mapped_suites_for "$f")"
  base=$(basename "$f"); base=${base%.sh}; base=${base%.py}
  case "$f" in
    # Handled by name in the SELFTEST / consumer block below — it is a matcher
    # with two callers and a --selftest matrix, not a script with a test-<n>.sh.
    agents/hooks/lib/scrutiny-verdict.sh) ;;
    agents/hooks/test/test-*.sh)      add_suite "$f" ;;
    # Anything else under test/ is a harness or a fixture, not a script with a
    # test-<n>.sh of its own. Must come BEFORE the agents/hooks/*.sh arm: a
    # case glob's `*` matches `/` too, so that arm would otherwise claim nested
    # paths and ask for a test-mutate-scrutiny-guards.sh that will never exist.
    agents/hooks/test/*)              ;;
    agents/hooks/lib/*.sh|agents/hooks/*.sh)
                                      add_suite "agents/hooks/test/test-$base.sh" ;;
    # Not a script — a shell one-liner embedded in a skill document. The /desk
    # step-9 done-proof silently weakened once already (explore-1fcd: a fully
    # retracted §2 counted as 13 lines of live content), and nothing on the box
    # ever ran it against a memo that was supposed to FAIL.
    agents/skills/desk/SKILL.md)      add_suite "agents/hooks/test/test-desk-done-proof.sh" ;;
    agents/scheduler/test-*.sh)       add_suite "$f" ;;
    # A mutation harness IS a gate; it has no test-<n>.sh of its own and never
    # will. Handled by name in the tunnel-ownership block below, exactly as
    # mutate-scrutiny-guards.sh is on the hooks side. Must precede the general
    # scheduler arm or the convention asks for a suite that cannot exist and the
    # UNCOVERED banner cries wolf on every edit to it.
    agents/scheduler/mutate-*.sh)     ;;
    agents/scheduler/*.sh|agents/scheduler/*.py)
                                      add_suite "agents/scheduler/test-$base.sh" ;;
    # agents/bin/ holds operator scripts, and hall (dotfiles-sb6s) is the first
    # one with a suite. The suite is a trigger for itself — weakening a guard
    # is usually an edit to its test.
    agents/bin/test-*.sh)             add_suite "$f" ;;
    agents/bin/hall)                  add_suite "agents/bin/test-hall.sh" ;;
    # A mutation harness IS a gate; it has no test-<n>.sh of its own and never
    # will. Same arm/reason as agents/scheduler/mutate-*.sh and
    # agents/lib/mutate-*.sh above. Must precede the general agents/bin/*.sh
    # arm below or the convention asks for a suite that cannot exist and the
    # UNCOVERED banner cries wolf on every edit. mutate-orphan-reaper.sh and
    # mutate-hall-prompt.sh each have their own dedicated invocation block
    # further down.
    agents/bin/mutate-*.sh)           ;;
    # dotfiles-e8l0: agents/bin/ was NOT one of the four convention-covered
    # dirs (hooks, scheduler, lib, doclint) — the two named arms above are the
    # only ones that ever reached it, so an operator script with neither a
    # test-<n>.sh NOR a name this hook already knew (claude-seat-link.sh,
    # restart-loop-check.sh, sync-tick-settings.sh, tmux-fixture-sweep.sh, at
    # the time this arm was added) was invisible to BOTH the gate and the
    # UNCOVERED banner — worse than the other three dirs' gap, where an
    # untested script at least gets NAMED. This general arm closes that: it
    # reports the same way lib/scheduler/doclint already do, coverage gaps and
    # all — a coverage question for those scripts to answer, not something
    # this arm silently answers FOR them by staying invisible.
    agents/bin/*.sh)                  add_suite "agents/bin/test-$base.sh" ;;
    agents/lib/test-*.sh)             add_suite "$f" ;;
    # A mutation harness IS a gate; it has no test-<n>.sh of its own and never
    # will. Same arm as agents/scheduler/mutate-*.sh above, same reason: without
    # it the convention asks for a suite that cannot exist and the UNCOVERED
    # banner cries wolf on every edit. Must precede the general agents/lib arm.
    # Handled by name in the laurels and glyph-property blocks below.
    agents/lib/mutate-*.sh)           ;;
    agents/lib/*.sh)                  add_suite "agents/lib/test-$base.sh" ;;
    agents/lib/*.py)                  add_suite "agents/lib/test-$base.sh" ;;
    agents/doclint/test-*.sh)         add_suite "$f" ;;
    agents/doclint/*.py)              add_suite "agents/doclint/test-$base.sh" ;;
  esac
done <<< "$STAGED"

# lib/scrutiny-verdict.sh has no test-<name>.sh of its own — it is a matcher
# with two consumers and a --selftest matrix. Name all three here rather than
# inventing a fourth wrapper. (This is the "name the consumer in the same
# change as the producer" rule, in gate form.)
SELFTEST=0
if printf '%s\n' "$STAGED" | grep -qE '^agents/hooks/(lib/scrutiny-verdict\.sh|pre-bead-close\.sh|test/test-pre-bead-close\.sh)$'; then
  SELFTEST=1
fi
if printf '%s\n' "$STAGED" | grep -qx 'agents/hooks/lib/scrutiny-verdict.sh'; then
  add_suite agents/hooks/test/test-pre-commit-checks.sh
  add_suite agents/hooks/test/test-pre-bead-close.sh
fi

# --- say what is NOT covered, BEFORE anything green scrolls past -----------
# "No suite found" and "suite passed" used to be indistinguishable: the only
# signal was a `note —` line printed AFTER every suite's output, worded "not a
# block". A P1 hook fix went through this gate on 2026-08-02 with zero suites
# run and nothing but two of those lines to show for it. A gate that cannot
# tell you it did not gate is the same defect it exists to prevent, so this
# goes FIRST, to stderr, and names the count.
if [ ${#UNCOVERED[@]} -gt 0 ]; then
  {
    echo
    echo "############################################################"
    echo "# pre-commit: ${#UNCOVERED[@]} STAGED SCRIPT(S) HAVE NO TEST SUITE."
    echo "# For these files this commit is gated on NOTHING:"
    for u in "${UNCOVERED[@]}"; do echo "#   • $u"; done
    echo "#"
    echo "# If a suite for one of them EXISTS under a different name, add it"
    echo "# to mapped_suites_for() in tools/githooks/pre-commit — that is the"
    echo "# bug dotfiles-dijt was filed for. If none exists, this is a real"
    echo "# coverage gap: verify by hand and say so in the commit message."
    echo "############################################################"
    echo
  } >&2
fi

if [ ${#MAP_BROKEN[@]} -gt 0 ]; then
  {
    echo
    echo "pre-commit: FAIL — the EXPLICIT SUITE MAP names ${#MAP_BROKEN[@]} file(s) that do not exist:"
    for b in "${MAP_BROKEN[@]}"; do echo "    $b"; done
    echo "  A suite was renamed or deleted and mapped_suites_for() was not updated."
    echo "  This is a bug in the gate itself, so it blocks rather than warns."
  } >&2
  FAILED=1
fi

# --- run them -------------------------------------------------------------
for s in ${SUITES+"${SUITES[@]}"}; do
  echo "pre-commit: running $s"
  if ! bash "$ROOT/$s"; then
    echo "pre-commit: FAIL — $s" >&2
    FAILED=1
  fi
done

if [ "$SELFTEST" -eq 1 ]; then
  echo "pre-commit: running pre-bead-close.sh --selftest (the scrutiny-verdict acceptance matrix)"
  if ! bash "$ROOT/agents/hooks/pre-bead-close.sh" --selftest; then
    echo "pre-commit: FAIL — pre-bead-close.sh --selftest" >&2
    FAILED=1
  fi
fi

# --- the scrutiny guards -> prove they still BITE --------------------------
# Narrower trigger than the suites above, and deliberately so. Measured on a
# 12-core box at load 8.4:
#
#     test-pre-commit-checks.sh          12s
#     test-pre-bead-close.sh             10s
#     mutate-scrutiny-guards.sh (6 mutants, 3 baseline runs)   88s
#
# 88s is real, and it is why this fires on six files rather than on every
# hooks edit. Those six are the ones whose change can silently kill the bite:
# the two gates, the shared matcher, the two suites, and the harness itself.
# Suite-green is not evidence here — all three of the 2026-08-01 survivors
# were green-suite survivors.
