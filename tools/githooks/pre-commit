# --- the banned git verbs, in EXECUTABLE examples (dotfiles-mjln) ----------
# AGENTS.md is always-loaded and its "Two writers, one working tree" table is
# measured; /commit's SKILL.md nonetheless shipped `git pull --rebase origin
# "$BRANCH"` inside a copy-pasteable bash block for four days, routing agents
# onto the rung whose refusal reflexively suggests `git stash` — the one verb
# in that table that destroys another writer's work. Nothing caught it: the
# doclint has no hook caller (it runs under /housekeeping), so the two files
# could contradict each other indefinitely.
#
# One rule, staged agent-facing markdown only: ~90ms, unlike the full lint.
DOCS=$(printf '%s\n' "$STAGED" | grep -E '^(agents/.*\.md|AGENTS\.md|CLAUDE\.md)$')
if [ -n "$DOCS" ] && [ -f "$ROOT/agents/doclint/doc-example-lint.py" ]; then
  PATHARGS=()
  while IFS= read -r d; do
    [ -n "$d" ] && [ -f "$ROOT/$d" ] && PATHARGS+=(--path "$ROOT/$d")
  done <<< "$DOCS"
  if [ ${#PATHARGS[@]} -gt 0 ]; then
    echo "pre-commit: linting staged docs for banned git verbs in executable examples"
    if ! python3 "$ROOT/agents/doclint/doc-example-lint.py" \
           --rule banned-git-verb "${PATHARGS[@]}"; then
      echo "pre-commit: FAIL — banned git verb in a documented example" >&2
      FAILED=1
    fi
  fi
fi

# --- the seats.yml DATA-FILE arm (dotfiles-lbxa) ---------------------------
# seats.yml is DATA, not a script — the convention loop above only maps
# scripts to test-<n>.sh suites, so a bad alias or a fallback-risk sigil in
# the roster had no commit-time gate at all (Review J). A wrong pin here
# misattributes every downstream row from the next tick, so this blocks
# rather than warns, same posture as the banned-git-verb doc lint above.
#
# The SEAT HISTORIES (refs/seats/*.history.md, dotfiles-qnfk R1) ride the same
# arm, and are data in the same sense. Two things are checked and both are
# invisible to every other gate: the roster and refs/seats/ must AGREE (a seat
# with no history file, or an orphan history belonging to no live-or-retired
# seat), and every history file must match its OWN integrity checksum. The
# second is the T6 mechanism — a seat that hand-edits its history to award
# itself a laurel produces a file whose checksum no longer matches, and this is
# where that stops being a diff nobody reads and starts being a blocked commit.
#
# agents/seats.json (dotfiles-btw8) rides the SAME arm: it is the VERBATIM
# sidecar harnessd relays, generated by this same validator's --emit-json
# mode (the ONE parser — see its module docstring). Drift between what's
# committed and what agents/seats.yml would regenerate is a commit failure
# here, not a runtime surprise the fleet join discovers later.
if printf '%s\n' "$STAGED" | grep -qE '^(agents/seats\.(yml|json)|agents/lib/validate-seats\.py|refs/seats/.*\.history\.md)$'; then
  if [ -f "$ROOT/agents/lib/validate-seats.py" ]; then
    HIST_ARGS=()
    if [ -d "$ROOT/refs/seats" ]; then
      HIST_ARGS=(--histories "$ROOT/refs/seats")
      echo "pre-commit: validating agents/seats.yml + refs/seats/ histories"
    else
      echo "pre-commit: validating staged agents/seats.yml (no refs/seats/ in this tree)"
    fi
    if ! python3 "$ROOT/agents/lib/validate-seats.py" "$ROOT/agents/seats.yml" \
           ${HIST_ARGS+"${HIST_ARGS[@]}"}; then
      echo "pre-commit: FAIL — agents/seats.yml failed validate-seats.py" >&2
      FAILED=1
    else
      REGEN_CMD="python3 agents/lib/validate-seats.py agents/seats.yml --emit-json agents/seats.json"
      SEATS_JSON_TMP=$(mktemp "${TMPDIR:-/tmp}/seats-json.XXXXXX")
      if python3 "$ROOT/agents/lib/validate-seats.py" "$ROOT/agents/seats.yml" \
             --emit-json "$SEATS_JSON_TMP" >/dev/null; then
        if ! diff -q "$SEATS_JSON_TMP" "$ROOT/agents/seats.json" >/dev/null 2>&1; then
          echo "pre-commit: FAIL — agents/seats.json is stale relative to agents/seats.yml." >&2
          echo "  Regenerate with: $REGEN_CMD" >&2
          echo "  then: git add agents/seats.json" >&2
          FAILED=1
        fi
      else
        echo "pre-commit: FAIL — could not regenerate agents/seats.json ($REGEN_CMD)" >&2
        FAILED=1
      fi
      rm -f "$SEATS_JSON_TMP"
    fi
  else
    echo "pre-commit: FAIL — agents/seats.yml is staged but agents/lib/validate-seats.py is missing" >&2
    FAILED=1
  fi
fi

# --- the LAURELS guards -> prove THEY still bite (dotfiles-qnfk) -----------
# Fifth instance of the mutation-harness argument, on a chain whose every
# failure mode is silent: an uncited laurel is a well-formed entry, a dropped
# ledger row leaves a history file that reads perfectly, an un-rolled-back row
# leaves a brief line for an entry that does not exist, and a cap that stops
# capping merely places more. The suite is 73 assertions and green against all
# of those in isolation — only the mutants show the guards biting. Measured on
# a 12-core box:
#
#     test-seat-history.sh (73 assertions, 11 cases)      6s
#     mutate-laurels.sh (8 mutants + baseline)           30s
#
# The convention arm above already runs the 6s suite, so this adds ~24s, to
# commits touching FOUR files. The test file is a trigger on purpose: T2's
# brief assertion is the SOLE detector for the dropped ledger write (the
# history file alone looks fine), so deleting one case loses the bite while the
# suite stays green.
if printf '%s\n' "$STAGED" | grep -qE '^(agents/lib/(seat-history|test-seat-history|mutate-laurels)\.sh|agents/skills/dream/dream\.py)$'; then
  echo "pre-commit: staged changes touch the laurel-placement chain -> running mutation harness (~30s)"
  if [ -f "$ROOT/agents/lib/mutate-laurels.sh" ]; then
    bash "$ROOT/agents/lib/mutate-laurels.sh" "$ROOT" || FAILED=1
  else
    echo "pre-commit: FAIL — agents/lib/mutate-laurels.sh is missing" >&2
    FAILED=1
  fi
fi

# Repeat the coverage gap as the LAST line too — the banner above is printed
# before ~90s of suite output on the slow path, and the last line of a hook is
# the one the agent actually reads.
if [ ${#UNCOVERED[@]} -gt 0 ]; then
  echo "pre-commit: ⚠ ${#UNCOVERED[@]} staged script(s) ran NO suite (see the banner above). Not a block; not a pass either." >&2
fi

if [ "$FAILED" -ne 0 ]; then
  cat >&2 <<'EOF'

pre-commit: BLOCKED. A hook test suite, the scrutiny --selftest, or the
mutation harness failed against the files in THIS worktree. The failing
item is named above.

Fix the hook (or the test) and commit again. Do NOT reach for --no-verify:
these hooks are the fleet's commit and bead-close gates, and the last time
one of them broke unnoticed it was a live false-accept that ran for weeks
against a green suite.
EOF
  exit 1
fi
exit 0
