#!/bin/sh

##### Set global variables #####
PLUGIN_DIR="$CONFIG_DIR/plugins"
HOOK_DIR="$CONFIG_DIR/hooks"

##### Initialize theme (bar appearance and defaults) #####
"$CONFIG_DIR/theme.sh" init

##### Load plugins dynamically #####
if [ -d "$PLUGIN_DIR" ]; then
  for plugin in "$PLUGIN_DIR"/*.sh; do
    [ -f "$plugin" ] || continue  # Skip if glob didn't match (literal * in filename)
    source "$plugin"
  done
fi

##### Register left items (from left to right) #####
register_spaces left
register_separator left
register_active left

##### Load and register hooks dynamically #####
if [ -d "$HOOK_DIR" ]; then
  for hook in "$HOOK_DIR"/*.sh; do
    [ -f "$hook" ] || continue  # Skip if glob didn't match (literal * in filename)
    source "$hook"
    # A shell function name cannot contain a hyphen, so a hook FILE named
    # `zig-computer.sh` must define `register_zig_computer` — underscores. The
    # bare `register_$(basename …)` this replaced derived `register_zig-computer`
    # and called a command that does not exist, so the hook loaded and then
    # registered NOTHING. Translate, and say so when the function is missing:
    # a silently-unregistered hook looks identical to a hook that ran.
    hook_fn="register_$(basename "$hook" .sh | tr '-' '_')"
    if declare -F "$hook_fn" >/dev/null; then
      "$hook_fn"
    else
      echo "sketchybarrc: $hook defines no $hook_fn() — not registered" >&2
    fi
  done
fi

##### Register right items (from right to left) #####
register_moon right
register_clock right
register_separator right separator2 ""
register_power right
register_volume right

##### Finalize setup #####
sketchybar --update
