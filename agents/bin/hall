#!/usr/bin/env bash
# hall — THE HALL, v0: the tmux-native court view + visit.  Bead dotfiles-sb6s.
#
# THE INVERSION (sb6s Overview): agents/seats.yml is TRUTH, tmux windows are
# CACHE.  The machinery owns window lifecycle; a hand-made window shows as
# UNREGISTERED (🚧) and is NEVER adopted silently.  Physical-layer vocabulary is
# the ratified estate lexicon (dotfiles-demesne-lexicon-gadu) — the ESTATE, the
# KEEP (zig-computer), the WORKS (pico), the ROADS (zig-zone); cited, not
# restated.  Seats SIT on hosts; hosts do not get seats.
#
# ---------------------------------------------------------------------------
# WHAT V0 IS, AND IS NOT
#
# v0 is DUMB GLASS over sources that are always there and always LOCAL: the
# ROSTER, the LIVE TMUX SERVER, and (since v1a) agents/scheduler/taps.conf.
# There is deliberately NO harnessd dependency — the cockpit must not die with
# the daemon (sb6s AC3) — and no network, no ssh and no ledger read from the
# renderer, because the court repaints every couple of seconds.  The state.json
# join (unread mail, marshal queue, tap HEADROOM) is v1; so are `hall
# mail/brief/queue/adopt/retire`.  Where a v1 field would go, this file has a
# reserved cell and a comment, never an invented value.
#
# WHAT V1A ADDED (dotfiles-oq4n): the tap column's POLICY layer — epoch-3 tap
# names and the per-seat `seat_home` override, both derived from taps.conf,
# both still local files.  What a live pane is ACTUALLY serving after a
# ceiling rollover is v1b and needs a source this renderer does not have; see
# the tap-column block below.
#
# VERBS
#   hall                the COURT VIEW (also `hall court`)
#   hall <seat|alias>   VISIT: switch to the seat's window, or MATERIALIZE it
#                       correctly (roster session, roster home as cwd, canonical
#                       name), LAUNCH it through pulse-inject.sh with /onboard,
#                       and then switch.  A window that already exists is
#                       switched to and NOTHING else — a warm seat is never
#                       re-onboarded.  (v0 launched nothing: "an empty shell in
#                       the right place is the correct v0 answer".  Zig
#                       overruled that from the first live visit —
#                       dotfiles-dsbl.  The hall still never types; the INJECTOR
#                       types, into a window it launched.)
#   hall --no-launch <seat>
#                       materialize/switch only.  Same as HALL_NO_LAUNCH=1.
#   hall home           the front desk: an alias for `hall seneschal`
#                       (ratified 2026-08-09 — attach lands at the desk).
#   hall --help
#
# `home` and `court` are RESERVED VERBS: a seat may not be named either.
#
# ---------------------------------------------------------------------------
# DISCIPLINE THIS SCRIPT IS BOUND BY
#
# * ONE ROSTER PARSER.  Everything here reads the roster through
#   agents/lib/seat-resolve.sh, which reuses validate-seats.py's YAML-subset
#   parser.  There is no second (or third) parser, and no `grep` of seats.yml.
# * R13 — session and window are SEPARATE FIELDS, never colon-joined into a
#   tmux `-t` target.  A `<session>:<window>` string is byte-identical in shape
#   to a tmux target and tmux matches targets by prefix/fnmatch, so a near-miss
#   silently binds the WRONG session.  Sessions are targeted as `=<name>`
#   (exact); windows are targeted by their `@<id>`, which is unique per server.
# * EXPLICIT SOCKET, ALWAYS, and `env -u TMUX` on every call: an inherited $TMUX
#   must never be able to redirect a -S-targeted call back at another server
#   (dotfiles-2v8h — a bare tmux command killed the live server once already).
# * THE HALL NAVIGATES, IT NEVER TYPES.  There is no send-keys in this file and
#   there must never be one; test-hall.sh asserts that mechanically.
# * EVERY GLYPH IN THE OUTPUT passes validate-seats.py's glyph rule —
#   Emoji_Presentation=Yes (the PROPERTY, dotfiles-gl6z), no U+2000-U+2BFF
#   outside the small proven allowlist, no denylisted glyph, no VS16.  That
#   means NO em dash and NO box drawing anywhere in the rendering — `·`
#   (U+00B7) and ASCII only.  test-hall.sh runs the court view's real output
#   through validate-seats.py's own checker.
#
#   ONE EXCEPTION, and it is Zig's own: `→` U+2192, the TAP COLUMN's override
#   separator (dotfiles-oq4n).  He picked it explicitly over the hall's
#   sketched `>` while ruling the statusline's rollover surface
#   (dotfiles-kcto: `🔌primary→secondary`), and the two surfaces say the same
#   thing, so they say it the same way.  The glyph rule is not weakened by it:
#   U+2192 is Emoji_Presentation=No, i.e. it is TEXT, and it is rendered ONLY
#   inside the tap column's text — never in a glyph column, never as a sigil,
#   never padded as 2 cells.  test-hall.sh allows exactly this codepoint and
#   nothing else, and asserts its measured width rather than assuming one.
# * THE COLUMN MATH ASSUMES EVERY GLYPH IS 2 CELLS, and hall_glyph_audit
#   ASSERTS it rather than hoping.  A text-presentation glyph (🗝 U+1F5DD and
#   friends: emoji-range, Emoji_Presentation=No) measures ONE cell, so its row
#   loses a column and the table stilts — which is exactly what Zig saw on
#   2026-08-09.  The audit names the offending seat on STDERR and the court
#   still renders: a cockpit that refuses to draw is worse than a crooked one.
# * printf PADS BY BYTES, the terminal draws CELLS, and the two are the same
#   number only for ASCII.  Every padded column here is ASCII except the tap
#   column, whose arrow is 3 bytes and ONE cell — so a `%-*s` field carrying
#   it must be handed a width that carries the excess bytes (hall_fieldw), or
#   every column to its right shifts left by 2.  Measured, not assumed: a
#   19-byte / 17-cell string in `%-20s` gets ONE space of padding, not three.
#
# Environment seams (all optional; they exist for the attach hook and tests,
# which must never touch the live tmux server):
#   SEATS_YML             explicit roster path (honored by seat-resolve.sh)
#   HALL_TMUX_SOCKET      tmux socket to read/act on (default: $TMUX's own)
#   HALL_SESSION          explicit target session for a visit (the attach hook
#                         passes #{hook_session_name}; otherwise unset)
#   HALL_ONLY_IF_ABSENT   1 = a visit materializes-and-selects ONLY when the
#                         window is absent; if it already exists, do nothing.
#                         This is the attach hook's guard: never yank a
#                         restored session (tmux-resurrect) to another window.
#
# Exit codes:  0 ok · 1 operational failure (no tmux/socket/session/home)
#              2 unknown seat or usage error · 3 roster missing or unreadable

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="$HERE/../lib"

if [ ! -f "$LIB/seat-resolve.sh" ]; then
  printf 'hall: cannot find agents/lib/seat-resolve.sh next to %s\n' "$HERE" >&2
  exit 3
fi
# shellcheck source=../lib/seat-resolve.sh
. "$LIB/seat-resolve.sh"

# THE TAP POLICY comes from agents/scheduler/taps.conf, read through the ONE
# parser that owns that file (tap-headroom.sh's th_conf_get) — the same
# discipline as the roster's one parser above.  Sourcing it is free: the file
# defines functions and reads nothing until asked, and it detects being sourced
# so th_main never runs here.
#
# OPTIONAL ON PURPOSE.  If the library (or the conf) is missing, every tap cell
# falls back to the roster's own value, unchanged — a cockpit that cannot read
# the tap policy still draws the court.
if [ -f "$LIB/tap-headroom.sh" ]; then
  # shellcheck source=../lib/tap-headroom.sh
  . "$LIB/tap-headroom.sh"
fi

# --- the glyph set ---------------------------------------------------------
# Emoji_Presentation=Yes codepoints only (AGENTS.md glyph rule).  📬 is PINNED by
# Zig, 2026-08-09: the unread-mail glyph is 📬 (U+1F4EC) and NEVER U+2709 ✉,
# which is in the banned U+2000-U+2BFF block.  It appears in the legend only —
# v0 has no mail state to report, and inventing one would be worse than a
# reserved cell.
G_WORKING='🧠'   # mid-turn
G_NEEDS='🔔'     # blocked on Zig (an open AskUserQuestion)
G_IDLE='✅'      # idle, nothing to ask
G_COMPACT='🌀'   # compacting
G_ASLEEP='💤'    # seated, but no window on this server
G_UNREG='🚧'     # a live window that matches NO seat and no alias
G_MAIL='📬'      # unread mail (v1 — needs harnessd state.json)

SEP='·'          # U+00B7, NOT an em dash: U+2014 is in the banned block.

# THE TAP COLUMN's override separator (Zig, 2026-08-09 — dotfiles-kcto, and see
# the glyph-rule exception in the discipline block).  TEXT, not a glyph: 3
# bytes, ONE cell.  It is the only non-ASCII character the hall ever prints
# inside a PADDED column, which is what hall_fieldw exists for.
TAP_ARROW='→'

# The pool table for THIS render: "<pool>\t<taps csv>\t<groups csv>" per line.
# Empty means "no tap policy in view" and the cells fall back to the roster.
_HALL_POOLTAB=''

TMUX_BIN=$(command -v tmux 2>/dev/null); [ -x "${TMUX_BIN:-}" ] || TMUX_BIN=/usr/bin/tmux

die() { local rc=$1; shift; printf 'hall: %s\n' "$*" >&2; exit "$rc"; }

# --- tmux, always socket-explicit and $TMUX-scrubbed ------------------------
tmux_e() { local sock=$1; shift; env -u TMUX "$TMUX_BIN" -S "$sock" "$@"; }

# hall_socket -> the tmux socket this hall reads and acts on.
hall_socket() {
  if [ -n "${HALL_TMUX_SOCKET:-}" ]; then printf '%s' "$HALL_TMUX_SOCKET"; return 0; fi
  if [ -n "${TMUX:-}" ]; then printf '%s' "${TMUX%%,*}"; return 0; fi
  local d
  d="/tmp/tmux-$(id -u)"
  [ -S "$d/default" ] && { printf '%s' "$d/default"; return 0; }
  return 1
}

# hall_bare <window-name> -> the name with any lexicon glyph removed.  The
# lexicon regex lives in exactly ONE place (seat-resolve.sh's
# _seat_strip_glyph); nothing here re-encodes the set.
hall_bare() { _seat_strip_glyph "$1"; }

# hall_status_glyph <window-name> -> the status glyph for a LIVE window: its own
# lexicon prefix when it has one, else ✅.  A live window with no glyph is idle
# by the lexicon's own definition (AGENTS.md: "bare name = fresh context
# awaiting its first prompt") — nothing there wants Zig.
#
# It is never empty ON PURPOSE.  Records below are tab-separated and read with
# IFS=$'\t'; tab is IFS *whitespace*, so bash collapses consecutive tabs into
# one and an empty middle field would silently shift every later column.
hall_status_glyph() {
  local bare prefix
  bare=$(_seat_strip_glyph "$1")
  prefix=${1%"$bare"}
  prefix=${prefix// /}
  [ -n "$prefix" ] || prefix="$G_IDLE"
  printf '%s' "$prefix"
}

# hall_live_windows <sock> -> "<session>\t<bare window>\t<status glyph>\t<activity>\t<window id>"
# for every window on that server.  READ-ONLY.  No field is ever empty (see
# hall_status_glyph on why that matters).
hall_live_windows() {
  local sock=$1 sess name act id
  tmux_e "$sock" list-windows -a -F '#{session_name}	#{window_name}	#{window_activity}	#{window_id}' \
    2>/dev/null | while IFS=$'\t' read -r sess name act id; do
      [ -n "${sess:-}" ] || continue
      printf '%s\t%s\t%s\t%s\t%s\n' \
        "$sess" "$(hall_bare "$name")" "$(hall_status_glyph "$name")" "$act" "$id"
    done
}

# hall_rel <epoch> -> a <=4 char relative age.  Column stability beats precision.
hall_rel() {
  local then=$1 now d
  [ -n "$then" ] || { printf '%s' '-'; return 0; }
  case "$then" in ''|*[!0-9]*) printf '%s' '-'; return 0 ;; esac
  now=$(date +%s); d=$(( now - then ))
  [ "$d" -lt 0 ] && d=0
  if   [ "$d" -lt 60 ];    then printf '%ss' "$d"
  elif [ "$d" -lt 3600 ];  then printf '%sm' "$(( d / 60 ))"
  elif [ "$d" -lt 86400 ]; then printf '%sh' "$(( d / 3600 ))"
  else                          printf '%sd' "$(( d / 86400 ))"
  fi
}

# hall_trunc <string> <width>
hall_trunc() {
  local s=$1 n=$2
  if [ "${#s}" -gt "$n" ]; then printf '%s.' "${s:0:$((n - 1))}"; else printf '%s' "$s"; fi
}

# hall_fieldw <string> <cells> -> the width to hand printf's `%-*s` so that the
# field occupies <cells> TERMINAL CELLS.
#
# printf pads by BYTES; the terminal draws CELLS. For ASCII those are the same
# number and every column here relied on that. The tap column's arrow is 3
# bytes and 1 cell, so a field holding one is 2 bytes "wide" that the terminal
# never draws — and everything to its right slides left by 2 per arrow.
#
# The byte count is taken by re-reading ${#s} under LC_ALL=C, which is the same
# expansion the padding itself is measured in; no fork, and nothing here has to
# know how many bytes any particular character costs.
hall_fieldw() {
  local s=$1 n=$2 chars=${#1}
  local LC_ALL=C
  printf '%s' "$(( n + ${#s} - chars ))"
}

# hall_trunc_tap <cell> <width> — the tap cell, truncated so the OVERRIDE
# survives.
#
# A plain cell truncates from the right like every other column. An
# `<home>→<override>` cell does not: the override is the only thing in that
# cell that can surprise you (it is why the column was rebuilt at all), so it
# keeps its full width and the home tap gives up the room —
# `pr.→secondary`, never `primary→seco.`.
hall_trunc_tap() {
  local s=$1 n=$2 left right keep
  [ "${#s}" -le "$n" ] && { printf '%s' "$s"; return 0; }
  case "$s" in
    *"$TAP_ARROW"*)
      left=${s%%"$TAP_ARROW"*}; right=${s#*"$TAP_ARROW"}
      keep=$(( n - ${#right} - 1 ))            # -1: the arrow is one cell
      if [ "$keep" -lt 2 ]; then
        # Not even room for `x.` on the left: the arrow and the override alone,
        # right-truncated. The cell is at its floor here, not lying.
        hall_trunc "$TAP_ARROW$right" "$n"
      else
        printf '%s.%s%s' "${left:0:$((keep - 1))}" "$TAP_ARROW" "$right"
      fi
      ;;
    *) hall_trunc "$s" "$n" ;;
  esac
}

# hall_plain <string> -> the same string with the typographic characters roster
# PROSE uses folded to something the court may print.  The rendering rule here
# is ASCII + `·` only (see the discipline block), and `charter-line:` is free
# text an author naturally writes with an em dash — every one of the roster's 18
# charter lines has one today.  The em dash becomes the hall's own separator;
# curly quotes become straight.
#
# It is applied to the CHARTER COLUMN ONLY, and that column is deliberately
# LAST on the line: a residual multibyte character would make printf's byte
# padding one cell short, and at the end of a row that costs nothing. If prose
# ever arrives with a character not folded here, test-hall.sh's glyph scan over
# the REAL roster is what says so.
hall_plain() {
  local s=$1
  s=${s//—/·}; s=${s//–/·}
  s=${s//’/\'}; s=${s//‘/\'}
  s=${s//“/\"}; s=${s//”/\"}
  printf '%s' "$s"
}

# hall_dashes <n> -> n ASCII hyphens (the rule under the header).
hall_dashes() {
  local n=$1 s=''
  while [ "${#s}" -lt "$n" ]; do s="$s----------"; done
  printf '%s' "${s:0:$n}"
}

# ---------------------------------------------------------------------------
# RESPONSIVE WIDTH (dotfiles-hnhl)
# ---------------------------------------------------------------------------
# Zig, 2026-08-09: on his PHONE tmux said "height too large" and showed NOTHING
# (the popup was hardcoded 84x32, bigger than the client — fixed in tmux.conf,
# which now sizes in PERCENT); on the desktop the court felt "a little
# squished". So the court reads the width it was actually given and renders one
# of three layouts.  The breakpoints are Zig's, by looking:
#
#   compact  < 60   sigil · name · status.  A phone.  Nothing else fits, and a
#                   wrapped row is worse than a missing column.
#   medium   60-99  the v0 court: office, status, last, model, tap (~66 cells).
#   wide     >=100  the room: a wider name and office, a full-width tap, and
#                   the seat's CHARTER LINE filling whatever is left.
#
# COLUMNS is the seam (tests set it; bash does not export it), then the real
# terminal via `tput cols`, then 80 — which is what a pipe or a cron gets, and
# is why the suite's default-width cases still see the medium layout.
hall_cols() {
  local c="${COLUMNS:-}"
  if [ -z "$c" ] && command -v tput >/dev/null 2>&1; then
    c=$(tput cols 2>/dev/null)   # allow-suppress: query; no tty is not an error
  fi
  case "$c" in ''|*[!0-9]*) c=80 ;; esac
  [ "$c" -lt 24 ] && c=24
  printf '%s' "$c"
}

# hall_layout <cols> [widest tap cell] — sets HALL_MODE and the column widths
# for this render.  Every width is a count of TERMINAL CELLS; printf pads by
# bytes, so any field that can hold the tap arrow goes through hall_fieldw
# (the sigil is the only glyph on the line, and hall_glyph_audit asserts it is
# 2 cells).
#
# THE TAP COLUMN IS SIZED TO ITS CONTENT (dotfiles-oq4n).  A fixed 8 was right
# while every cell was one word; an override cell is `primary→secondary`, 17,
# and a fixed 8 would truncate away the exact thing the cell was rebuilt to
# show.  So the caller measures the widest cell it is about to draw and the
# layout gives it that, bounded at both ends — never below the old 8/10, never
# above TAP_MAX.
TAP_MAX=20
hall_layout() {
  local cols=$1 tapw=${2:-0} fixed room
  if [ "$cols" -lt 60 ]; then
    HALL_MODE=compact
    # sigil(2) + 2 + name + 1 + st(2), and one cell of slack so a terminal that
    # wraps at exactly $cols never wraps a row.
    W_NAME=$(( cols - 8 )); W_OFFICE=0; W_MODEL=0; W_TAP=0; W_CHARTER=0
    [ "$W_NAME" -gt 14 ] && W_NAME=14
    [ "$W_NAME" -lt 8 ] && W_NAME=8
  elif [ "$cols" -lt 100 ]; then
    HALL_MODE=medium
    W_NAME=11; W_MODEL=6; W_CHARTER=0
    W_TAP=$tapw
    [ "$W_TAP" -lt 8 ] && W_TAP=8
    [ "$W_TAP" -gt "$TAP_MAX" ] && W_TAP=$TAP_MAX
    # The OFFICE column absorbs the slack: at 80 it is capped at 26 so the
    # table does not sprawl ahead of the wide layout, which is where the extra
    # room earns its keep.
    fixed=$(( 2 + 2 + W_NAME + 1 + 1 + 2 + 1 + 4 + 1 + W_MODEL + 1 ))
    room=$(( cols - fixed - 1 ))            # office + tap, together
    W_OFFICE=$(( room - W_TAP ))
    [ "$W_OFFICE" -gt 26 ] && W_OFFICE=26
    if [ "$W_OFFICE" -lt 14 ]; then
      # Near the 60-cell floor the two columns cannot both have what they want.
      # THE TAP GIVES UP LAST, down to its old 8: a truncated OFFICE still
      # names the seat's job and the seat column above it is intact, while a
      # truncated TAP hides the override — the one thing in that cell that can
      # surprise you.
      W_OFFICE=14
      W_TAP=$(( room - W_OFFICE ))
      [ "$W_TAP" -lt 8 ] && W_TAP=8
    fi
  else
    HALL_MODE=wide
    W_NAME=14; W_OFFICE=30; W_MODEL=6
    W_TAP=$tapw
    [ "$W_TAP" -lt 10 ] && W_TAP=10
    [ "$W_TAP" -gt "$TAP_MAX" ] && W_TAP=$TAP_MAX
    # everything left after: sigil(2) + 2 + name + 1 + office + 1 + st(2) + 1 +
    # last(4) + 1 + model + 1 + tap + 1 — minus one cell of slack, so a row is
    # never exactly the terminal's width (where a wrap is one stray byte away).
    W_CHARTER=$(( cols - (2 + 2 + W_NAME + 1 + W_OFFICE + 1 + 2 + 1 + 4 + 1 + W_MODEL + 1 + W_TAP + 1) - 1 ))
    [ "$W_CHARTER" -lt 12 ] && W_CHARTER=12
  fi
}

# hall_expand_home <roster home> -> absolute path (`~` and `~/x` only; the
# roster never uses `~user`).
#
# The escaped `~` in the strip below is a PATTERN, not a path: it must stay
# literal so it matches the roster's own `~/`. shellcheck reads it as a failed
# tilde expansion (SC2088); it is the opposite, hence the directive — which has
# to sit in front of the whole `case`, since a directive on one case BRANCH is
# a parse error (SC1124).
# shellcheck disable=SC2088
hall_expand_home() {
  case "$1" in
    '~')    printf '%s' "$HOME" ;;
    '~/'*)  printf '%s/%s' "$HOME" "${1#\~/}" ;;
    *)      printf '%s' "$1" ;;
  esac
}

# hall_taps_of <seat> <dump> -> the distinct taps this seat's schedules bind,
# comma-joined; empty when the seat has no schedule (an interactive seat draws
# whatever its window was launched with — v0 cannot know it, and says so).
hall_taps_of() {
  printf '%s\n' "$2" | awk -F'\t' -v s="$1" '$1=="sched" && $2==s {print $4}' | sort -u | paste -sd, -
}

# ---------------------------------------------------------------------------
# THE TAP COLUMN — v1a, THE POLICY LAYER (dotfiles-oq4n)
# ---------------------------------------------------------------------------
# THE SEAT'S OWN `tap:` (Zig, 2026-08-09, off this very column): it used to be
# DERIVED from the seat's schedules, so the seven schedule-less seats rendered
# `-` — and `-` read as "no tap" when the truth was "personal, like everything
# else".  The roster now states it, the validator requires it.  A `-` here
# means one thing only: an UNREGISTERED window, where emptiness is the honest
# answer.  The schedule-derived value survives as the FALLBACK for a roster
# older than the rule.
#
# WHAT V1A ADDED, AND WHY.  Zig looked at the court on 2026-08-09 and read
# `personal` against the marshal while the live policy was
# `seat_home.marshal=secondary`.  The cell was lying by omission twice: it
# printed the EPOCH-2 tap name (renamed `personal`->`primary` and
# `work`->`linearb` that same evening — agents/scheduler/taps.conf's own EPOCH
# 3 block) and it knew nothing about the per-seat home-tap override.  So the
# cell now renders the POLICY layer, in two parts:
#
#   <tap>                the seat's roster tap in EPOCH-3 naming
#   <tap>→<pool>         …and the pool its `seat_home.<seat>` override sends it
#                        to, when that pool is a DIFFERENT one
#
# THREE RULES THAT KEEP IT HONEST:
#
#   * THE EPOCH MAP IS DERIVED FROM THE CONF, never hardcoded here.  A value
#     the conf lists in some `pool.<p>.taps=` is already an epoch-3 tap name
#     and is printed back unchanged (this is why `tick` stays `tick` rather
#     than collapsing into its pool: `tick` IS a tap, it merely shares
#     primary's account and therefore primary's ceiling).  A value that
#     survives only in a `pool.<p>.groups=` list is an epoch-2 alias, and that
#     list's FIRST entry is the same pool's epoch-3 name by the conf's own
#     stated ordering.  Anything the conf has never heard of prints unchanged.
#   * AN OVERRIDE THAT AGREES IS NOT NEWS.  `seat_home.linearb=linearb` on a
#     seat whose tap already resolves to the linearb pool renders `linearb`,
#     not `linearb→linearb`.  The arrow means "this seat starts somewhere
#     other than where its tap would put it", and nothing else.
#   * NO CONF, NO CHANGE.  A missing or unreadable taps.conf leaves every cell
#     at the v0 roster value — no error text in the cell, no dash, no guess.
#
# ⚠️ WHAT THIS CELL STILL DOES NOT KNOW — v1b, THE SERVING TAP.  This is the
# PREFERRED/home tap: policy, read from two local files.  It is NOT what a live
# pane is actually running, which can differ the moment a launch rolls over at
# its ceiling (agents/lib/tap-headroom.sh's th_pick_pool).  Surfacing that needs
# the gateway capture / the wrapper's own exports (dotfiles-d5sq, and the
# statusline's W3), and it must NOT arrive by having the hall read
# tap-rollover.jsonl or ssh pico from the renderer: the court repaints every two
# seconds and its whole charter is that it stays fast and local.  v1b adds a
# source; it does not change this rendering.
#
# (The seam comment this replaces sketched the separator as `work>tick`.  Zig
# ruled U+2192 instead when he ruled the statusline's rollover surface —
# dotfiles-kcto, `🔌primary→secondary` — and the two surfaces say the same
# thing, so they say it the same way.)

# hall_pool_table -> "<pool>\t<taps csv>\t<groups csv>" per pool, in the conf's
# preference order.  Empty when there is no conf and no library: every caller
# treats that as "no tap policy in view".
hall_pool_table() {
  local p taps groups
  declare -F th_conf_get >/dev/null 2>&1 || return 0
  for p in $(th_pools); do
    taps=$(th_conf_get "pool.$p.taps")
    groups=$(th_conf_get "pool.$p.groups")
    printf '%s\t%s\t%s\n' "$p" "$taps" "$groups"
  done
}

# hall_tap_epoch3 <roster tap> <pool table> -> "<epoch-3 tap>\t<pool>", or
# nothing at all when the conf does not recognise the value.
hall_tap_epoch3() {
  local want=$1 tab=$2 pool taps groups t
  [ -n "$want" ] || return 0
  [ -n "$tab" ] || return 0
  # An EPOCH-3 tap name: the conf lists it as a tap of some pool.
  while IFS=$'\t' read -r pool taps groups; do
    [ -n "${pool:-}" ] || continue
    for t in ${taps//,/ }; do
      [ "$t" = "$want" ] && { printf '%s\t%s' "$want" "$pool"; return 0; }
    done
  done <<<"$tab"
  # An EPOCH-2 name: it survives only in `groups=`, whose first value is that
  # pool's epoch-3 name (the conf states that ordering; this reads it).
  while IFS=$'\t' read -r pool taps groups; do
    [ -n "${pool:-}" ] || continue
    for t in ${groups//,/ }; do
      [ "$t" = "$want" ] && { printf '%s\t%s' "${groups%%,*}" "$pool"; return 0; }
    done
  done <<<"$tab"
  return 0
}

# hall_tap_cell <seat> <dump> -> the TAP COLUMN's contents for one seat.
hall_tap_cell() {
  local seat=$1 dump=$2 t e name pool home
  t=$(printf '%s\n' "$dump" | awk -F'\t' -v s="$seat" '$1=="seat" && $2==s {print $10; exit}')
  [ -n "$t" ] || t=$(hall_taps_of "$seat" "$dump")
  [ -n "$t" ] || { printf '%s' '-'; return 0; }

  e=$(hall_tap_epoch3 "$t" "$_HALL_POOLTAB")
  [ -n "$e" ] || { printf '%s' "$t"; return 0; }
  name=${e%%$'\t'*}
  pool=${e#*$'\t'}

  home=''
  declare -F th_conf_get >/dev/null 2>&1 && home=$(th_conf_get "seat_home.$seat")
  if [ -n "$home" ] && [ "$home" != "$pool" ]; then
    printf '%s%s%s' "$name" "$TAP_ARROW" "$home"
  else
    printf '%s' "$name"
  fi
}

# hall_tap_cells <dump> -> "<seat>\t<cell>" for every roster seat, computed
# ONCE per render.  The row loop below looks cells up in this instead of
# recomputing them, so growing the column costs no extra conf reads.
hall_tap_cells() {
  local name
  while IFS=$'\t' read -r _tag name _rest; do
    [ -n "${name:-}" ] || continue
    printf '%s\t%s\n' "$name" "$(hall_tap_cell "$name" "$1")"
  done <<<"$(printf '%s\n' "$1" | awk -F'\t' '$1=="seat"')"
}

# hall_tap_of <seat> <cells> -> one seat's precomputed cell, or `-`.
hall_tap_of() {
  local s c
  while IFS=$'\t' read -r s c; do
    [ "$s" = "$1" ] && { printf '%s' "$c"; return 0; }
  done <<<"$2"
  printf '%s' '-'
}

# hall_tap_widest <cells> -> the widest cell, in CELLS.
#
# Bash's ${#s}, not awk's length(): awk's is characters under gawk and BYTES
# under mawk, and this machine's /usr/bin/awk is not a fixed fact. Every
# character a tap cell can hold — ASCII plus the 1-cell arrow — is one cell, so
# a character count IS the cell count here.
hall_tap_widest() {
  local s c m=0
  while IFS=$'\t' read -r s c; do
    [ -n "${s:-}" ] || continue
    [ "${#c}" -gt "$m" ] && m=${#c}
  done <<<"$1"
  printf '%s' "$m"
}

# hall_glyph_audit <dump> — THE COLUMN MATH, ASSERTED (dotfiles-gl6z).
#
# Every glyph column in the court is padded as 2 cells.  That is only true for
# Emoji_Presentation=Yes codepoints; a text-default glyph from inside the emoji
# blocks measures ONE, and its whole row shifts left by a column.  Rather than
# re-encode the Unicode property here, this asks the ONE place that owns it —
# validate-seats.py, the same module seat-resolve.sh already reuses for the
# roster parse.  One python3 call per court render, over the hall's own status
# glyphs plus every roster sigil.
#
# It writes to STDERR and never blocks: a stilted court is a roster bug to be
# named, not a reason for the cockpit to refuse to draw.  Silent when clean.
hall_glyph_audit() {
  local validator name sigil
  # ONCE per process. The interactive court repaints every couple of seconds
  # (dotfiles-hnhl), and a warning that repeats every two seconds is a warning
  # nobody reads — the roster cannot change mid-watch anyway.
  [ "${_HALL_AUDITED:-0}" = 1 ] && return 0
  _HALL_AUDITED=1
  validator=$(_seat_validator) || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  # argv, not stdin: `python3 - <<'PY'` already spends stdin on the script
  # itself, so piping the roster in would silently hand python an empty pipe.
  local args=(
    "legend:$G_WORKING" "legend:$G_NEEDS" "legend:$G_IDLE" "legend:$G_COMPACT"
    "legend:$G_ASLEEP" "legend:$G_UNREG" "legend:$G_MAIL"
  )
  while IFS=$'\t' read -r name sigil; do
    [ -n "${name:-}" ] && [ -n "${sigil:-}" ] && args+=("$name:$sigil")
  done <<<"$(printf '%s\n' "$1" | awk -F'\t' '$1=="seat"{print $2 "\t" $8}')"
  python3 - "$validator" "${args[@]}" <<'PY' >&2
import importlib.util
import sys

spec = importlib.util.spec_from_file_location("_hall_vs", sys.argv[1])
vs = importlib.util.module_from_spec(spec)
spec.loader.exec_module(vs)

pairs = [tuple(a.split(":", 1)) for a in sys.argv[2:] if ":" in a]

bad = []
for owner, glyph in pairs:
    reason = vs.sigil_violation(glyph)
    width = vs.display_width(glyph)
    if reason or width != 2:
        bad.append(f"    {owner}: {glyph!r} width={width} — {reason or 'not 2 cells wide'}")

if bad:
    print(f"hall: GLYPH RULE — {len(bad)} glyph(s) in this court are not 2 cells "
          f"wide, so their rows are stilted (dotfiles-gl6z):")
    print("\n".join(bad))
    print("    Fix the roster (agents/seats.yml) — validate-seats.py rejects these.")
PY
  return 0
}

# hall_seat_of_window <bare window> <dump> -> canonical seat, or non-zero.
hall_seat_of_window() {
  local hit
  hit=$(_seat_lookup "$1" "$2") || return 1
  printf '%s' "${hit#*$'\t'}"
}

# ---------------------------------------------------------------------------
# THE COURT VIEW
# ---------------------------------------------------------------------------
# Width-stable by construction, for display-popup: fixed column widths, one
# glyph per glyph-column (assumed 2 cells wide), text columns truncated.  Byte
# padding via printf %-Ns is safe here because every text column is ASCII —
# seat names are ^[a-z][a-z0-9-]+$ (R1) and offices are English.  A non-ASCII
# office would skew one row; that is a roster question, not a renderer one.
# The ONE deliberate exception is the tap column's arrow, which is 3 bytes and
# 1 cell and therefore goes through hall_fieldw wherever it is padded.
#
# v0 matches a live window to a seat BY NAME (exact, then alias) within this
# server.  Session qualification is moot on the keep — Zig's 2026-08-09
# topology ruling made it one session per server, named for the host, so
# session:window == host:seat universally — and the seats that have no schedule
# at all (seneschal, marshal, dotfiles, harnessd, romd, tinker, orator) have no
# binding session to qualify against.  The session each match was found in is
# printed for the unregistered rows, where it is the actionable fact.
court() {
  local dump sock live host role cur_window cur_seat cur_tap tapcells tapw
  dump=$(_seat_dump) || die 3 "roster could not be read (see the parse error above). Set \$SEATS_YML or install the agents tier."

  # THE TAP POLICY, once per render — not once per process. taps.conf is a file
  # Zig edits by hand while watching this court repaint, so a per-process cache
  # would show him the policy he had when the popup opened. It is one conf read
  # per pool; the per-seat cells below are computed from it exactly once each.
  _HALL_POOLTAB=$(hall_pool_table)
  tapcells=$(hall_tap_cells "$dump")
  tapw=$(hall_tap_widest "$tapcells")

  sock=$(hall_socket) || sock=""
  live=""
  if [ -n "$sock" ]; then live=$(hall_live_windows "$sock"); fi

  host=$(hostname -s 2>/dev/null || printf 'unknown')
  # dotfiles-demesne-lexicon-gadu: zig-computer IS the keep. Any other host
  # names itself rather than claiming a role it was not given.
  if [ "$host" = "zig-computer" ]; then role="the KEEP ($host)"; else role="host $host"; fi

  # The header's tap is the CURRENT WINDOW's tap (sb6s Overview: visiting the
  # Factor flips it to tap:work).  The current window is the CLIENT's, not this
  # process's: inside display-popup this script has no window of its own.
  cur_window=""
  if [ -n "$sock" ]; then
    cur_window=$(tmux_e "$sock" display-message -p '#{window_name}' 2>/dev/null)
  fi
  cur_tap='-'
  cur_seat='-'
  if [ -n "$cur_window" ]; then
    if cur_seat=$(hall_seat_of_window "$(hall_bare "$cur_window")" "$dump"); then
      cur_tap=$(hall_tap_cell "$cur_seat" "$dump")
    else
      cur_seat="$(hall_bare "$cur_window") $G_UNREG"
    fi
  fi

  local cols
  cols=$(hall_cols)
  hall_layout "$cols" "$tapw"

  # 4 leading spaces, not 3: the sigil column is one emoji (2 cells) plus 2
  # spaces. Every column below is byte-padded ASCII, so the header, the rule
  # and every row land on the same boundaries.
  case "$HALL_MODE" in
    compact)
      # A phone. The host and the tap do not survive the cut: on a 40-cell
      # screen the question is "who is awake", and one wrapped row destroys
      # more than a missing column does.
      printf 'THE HALL %s here: %s\n' "$SEP" "$(hall_trunc "$cur_seat" 14)"
      printf '    %-*s %-2s\n' "$W_NAME" seat st
      printf '    %s %s\n' "$(hall_dashes "$W_NAME")" '--'
      ;;
    medium)
      # The HOST, not the full estate role: "the KEEP (zig-computer)" costs 12
      # cells this line does not have at 60, and the room to say it properly is
      # exactly what the wide layout has.
      printf 'THE HALL %s %s %s here: %s %s tap: %s\n' \
        "$SEP" "$host" "$SEP" "$(hall_trunc "$cur_seat" 16)" "$SEP" "$cur_tap"
      printf '    %-*s %-*s %-2s %-4s %-*s %s\n' \
        "$W_NAME" seat "$W_OFFICE" office st last "$W_MODEL" model tap
      printf '    %s %s %s %s %s %s\n' \
        "$(hall_dashes "$W_NAME")" "$(hall_dashes "$W_OFFICE")" '--' '----' \
        "$(hall_dashes "$W_MODEL")" "$(hall_dashes 3)"
      ;;
    *)
      printf 'THE HALL %s %s %s here: %s %s tap: %s\n' \
        "$SEP" "$role" "$SEP" "$cur_seat" "$SEP" "$cur_tap"
      printf '    %-*s %-*s %-2s %-4s %-*s %-*s %s\n' \
        "$W_NAME" seat "$W_OFFICE" office st last "$W_MODEL" model \
        "$W_TAP" tap charter
      printf '    %s %s %s %s %s %s %s\n' \
        "$(hall_dashes "$W_NAME")" "$(hall_dashes "$W_OFFICE")" '--' '----' \
        "$(hall_dashes "$W_MODEL")" "$(hall_dashes "$W_TAP")" \
        "$(hall_dashes "$W_CHARTER")"
      ;;
  esac

  local seated=0 asleep=0
  # TEN fields, not nine: the seat's own `tap` is field 10 (seat-resolve.sh's
  # dump contract). Name it, or `charter` swallows both.
  local name model home _history office sigil charter tap
  while IFS=$'\t' read -r _tag name model _effort home _history office sigil charter tap; do
    [ -n "${name:-}" ] || continue
    seated=$((seated + 1))
    local aliases hit glyph act row tapcell
    aliases=$(printf '%s\n' "$dump" | awk -F'\t' -v s="$name" '$1=="alias" && $3==s {print $2}')
    # The seat's live window: its own name first, then any alias (a window that
    # was never literally renamed is still that seat's window — that is what
    # the alias list is FOR).
    hit=$(printf '%s\n' "$live" | awk -F'\t' -v names="$(printf '%s %s' "$name" "$(printf '%s' "$aliases" | tr '\n' ' ')")" '
      BEGIN { n = split(names, a, " "); for (i = 1; i <= n; i++) if (a[i] != "") k[a[i]] = i }
      $2 in k { print k[$2] "\t" $0 }' | sort -n | head -1 | cut -f2-)
    if [ -n "$hit" ]; then
      glyph=$(printf '%s' "$hit" | cut -f3)
      act=$(hall_rel "$(printf '%s' "$hit" | cut -f4)")
    else
      glyph="$G_ASLEEP"; act='-'; asleep=$((asleep + 1))
    fi
    case "$HALL_MODE" in
      compact)
        # LIVE WINDOWS ONLY (Zig, 2026-08-09, from his phone: the list is "still
        # too long"). A 💤 row is a seat with no window — nothing to watch, and
        # on a phone every row costs a screenful. The seat is still REACHABLE:
        # you type its name at the prompt and it wakes, which is what the footer
        # says. The count line below keeps the asleep ones honest, and every
        # wider layout still draws the whole roster.
        [ "$glyph" = "$G_ASLEEP" ] && continue
        printf '%s  %-*s %s\n' "$sigil" "$W_NAME" "$(hall_trunc "$name" "$W_NAME")" "$glyph"
        ;;
      medium)
        # The tap is LAST on this line and therefore unpadded — no hall_fieldw
        # needed, and none wanted: nothing follows it to shift.
        printf '%s  %-*s %-*s %s %-4s %-*s %s\n' \
          "$sigil" "$W_NAME" "$(hall_trunc "$name" "$W_NAME")" \
          "$W_OFFICE" "$(hall_trunc "$office" "$W_OFFICE")" \
          "$glyph" "$act" "$W_MODEL" "$(hall_trunc "${model:--}" "$W_MODEL")" \
          "$(hall_trunc_tap "$(hall_tap_of "$name" "$tapcells")" "$W_TAP")"
        ;;
      *)
        # …here the CHARTER follows it, so the tap field's width is computed
        # from the cell's own bytes (hall_fieldw) instead of assumed.
        tapcell=$(hall_trunc_tap "$(hall_tap_of "$name" "$tapcells")" "$W_TAP")
        printf '%s  %-*s %-*s %s %-4s %-*s %-*s %s\n' \
          "$sigil" "$W_NAME" "$(hall_trunc "$name" "$W_NAME")" \
          "$W_OFFICE" "$(hall_trunc "$office" "$W_OFFICE")" \
          "$glyph" "$act" "$W_MODEL" "$(hall_trunc "${model:--}" "$W_MODEL")" \
          "$(hall_fieldw "$tapcell" "$W_TAP")" "$tapcell" \
          "$(hall_trunc "$(hall_plain "$charter")" "$W_CHARTER")"
        ;;
    esac
  done <<<"$(printf '%s\n' "$dump" | awk -F'\t' '$1=="seat"')"

  # …and when the filter above hid EVERYTHING, say so in one line rather than
  # leaving a hole where the table was. A phone that shows only live windows and
  # has none to show must still answer the question it was opened to answer.
  if [ "$HALL_MODE" = compact ] && [ "$seated" -gt 0 ] && [ "$asleep" = "$seated" ]; then
    local msg
    msg="all $seated seats asleep $SEP type a name to wake one"
    # ${#msg} is characters, and every character here is one cell (ASCII + ·).
    if [ "${#msg}" -le "$cols" ]; then
      printf '%s\n' "$msg"
    else
      # A narrow phone: two short lines, never one wrapped one — a wrapped line
      # is the stilt this whole layout exists to avoid.
      printf 'all %s seats asleep\n' "$seated"
      printf 'type a name to wake one\n'
    fi
  fi

  # 🚧 — live windows that match NO seat and no alias.  Never adopted silently
  # (sb6s AC2): the hall reports them and stops.  Adoption is a v1 verb that
  # writes THROUGH the roster.
  local unreg=0 sess bare _g act _id
  while IFS=$'\t' read -r sess bare _g act _id; do
    [ -n "${bare:-}" ] || continue
    hall_seat_of_window "$bare" "$dump" >/dev/null && continue
    unreg=$((unreg + 1))
    case "$HALL_MODE" in
      compact)
        printf '%s  %-*s %s\n' "$G_UNREG" "$W_NAME" "$(hall_trunc "$bare" "$W_NAME")" "$G_UNREG"
        ;;
      medium)
        printf '%s  %-*s %-*s %s %-4s %-*s %s\n' \
          "$G_UNREG" "$W_NAME" "$(hall_trunc "$bare" "$W_NAME")" \
          "$W_OFFICE" "$(hall_trunc "no seat in $sess" "$W_OFFICE")" \
          "$G_UNREG" "$(hall_rel "$act")" "$W_MODEL" '-' '-'
        ;;
      *)
        printf '%s  %-*s %-*s %s %-4s %-*s %-*s %s\n' \
          "$G_UNREG" "$W_NAME" "$(hall_trunc "$bare" "$W_NAME")" \
          "$W_OFFICE" "$(hall_trunc "no seat in $sess" "$W_OFFICE")" \
          "$G_UNREG" "$(hall_rel "$act")" "$W_MODEL" '-' "$W_TAP" '-' \
          "$(hall_trunc "not in the roster $SEP the hall never adopts silently" "$W_CHARTER")"
        ;;
    esac
  done <<<"$live"

  # THE LEGEND, and THE FOOTER THAT TEACHES THE PROMPT (dotfiles-hnhl).
  # "hall <seat> to visit" read as an instruction to type those exact words —
  # Zig typed a bare seat name instead, which was the better instinct and is
  # now what the prompt accepts (both forms do). So the footer says what to
  # TYPE, not what to run.
  if [ "$HALL_MODE" = compact ]; then
    printf '\n%s working %s %s needs Zig %s %s idle\n' \
      "$G_WORKING" "$SEP" "$G_NEEDS" "$SEP" "$G_IDLE"
    printf '%s no window %s %s unregistered\n' "$G_ASLEEP" "$SEP" "$G_UNREG"
    printf '%s seats %s %s asleep %s %s unreg\n' \
      "$seated" "$SEP" "$asleep" "$SEP" "$unreg"
    printf 'type a seat name %s Enter closes\n' "$SEP"
  else
    printf '\n%s working %s %s needs Zig %s %s idle %s %s compacting\n' \
      "$G_WORKING" "$SEP" "$G_NEEDS" "$SEP" "$G_IDLE" "$SEP" "$G_COMPACT"
    printf '%s no window %s %s unregistered %s %s unread mail (v1)\n' \
      "$G_ASLEEP" "$SEP" "$G_UNREG" "$SEP" "$G_MAIL"
    printf '%s seats %s %s asleep %s %s unregistered\n' \
      "$seated" "$SEP" "$asleep" "$SEP" "$unreg"
    if [ "$HALL_MODE" = wide ]; then
      printf 'type a seat name (or %s) %s home is the front desk %s Enter or Esc closes\n' \
        "'hall <seat>'" "$SEP" "$SEP"
    else
      printf 'type a seat name (or %s) %s Enter or Esc closes\n' "'hall <seat>'" "$SEP"
    fi
  fi
  if [ -z "$sock" ]; then
    printf 'no tmux server in view: roster only. The court still renders.\n'
  fi

  # LAST, and on stderr: the column math the table above was drawn with.
  hall_glyph_audit "$dump"
}

# ---------------------------------------------------------------------------
# VISIT
# ---------------------------------------------------------------------------

# hall_near <input> <dump> — near matches for an unknown seat, on stderr.
hall_near() {
  local want=$1 dump=$2 near all
  all=$(printf '%s\n' "$dump" | awk -F'\t' '$1=="seat"{print $2} $1=="alias"{print $2 " (alias of " $3 ")"}')
  near=$(printf '%s\n' "$all" | grep -i -- "$want")
  if [ -n "$near" ]; then
    printf 'hall: no seat %s. Did you mean:\n' "'$want'" >&2
    printf '%s\n' "$near" | sed 's/^/    /' >&2
  else
    printf 'hall: no seat %s. The roster holds:\n' "'$want'" >&2
    printf '%s\n' "$all" | sed 's/^/    /' >&2
  fi
}

# hall_target_session <seat> <dump> <sock> -> the session the seat's window
# belongs in.  Precedence: explicit override (the attach hook) > the roster's
# own binding > the client's current session > the only session on the server.
# Nothing here invents a session NAME — the roster and the live server are the
# only two authorities, exactly as seat-resolve.sh refuses to hardcode one.
hall_target_session() {
  local seat=$1 dump=$2 sock=$3 bound n cur first
  if [ -n "${HALL_SESSION:-}" ]; then printf '%s' "$HALL_SESSION"; return 0; fi
  bound=$(printf '%s\n' "$dump" | awk -F'\t' -v s="$seat" '$1=="sched" && $2==s {print $5}' | sort -u)
  n=$(printf '%s' "$bound" | grep -c .)
  if [ "$n" = 1 ]; then printf '%s' "$bound"; return 0; fi
  if [ "$n" -gt 1 ]; then
    printf 'hall: seat %s has bindings in %s sessions (%s) — pass HALL_SESSION to choose.\n' \
      "'$seat'" "$n" "$(printf '%s' "$bound" | tr '\n' ' ')" >&2
    return 1
  fi
  [ -n "$sock" ] || return 1
  cur=$(tmux_e "$sock" display-message -p '#{session_name}' 2>/dev/null)
  [ -n "$cur" ] && { printf '%s' "$cur"; return 0; }
  first=$(tmux_e "$sock" list-sessions -F '#{session_name}' 2>/dev/null | head -1)
  [ -n "$first" ] && { printf '%s' "$first"; return 0; }
  return 1
}

# hall_find_window <sock> <session> <name...> -> the window id whose
# glyph-stripped name matches any of the given names.  Names are matched in the
# order given, so the canonical name wins over an alias.
hall_find_window() {
  local sock=$1 sess=$2; shift 2
  local wanted="$*" id name bare w
  tmux_e "$sock" list-windows -t "=$sess" -F '#{window_id}	#{window_name}' 2>/dev/null \
    | while IFS=$'\t' read -r id name; do
        bare=$(hall_bare "$name")
        for w in $wanted; do
          [ "$bare" = "$w" ] && { printf '%s' "$id"; return 0; }
        done
      done
}

# ---------------------------------------------------------------------------
# LAUNCH (dotfiles-dsbl) — materialize, THEN hand the window to the injector
# ---------------------------------------------------------------------------
# Zig, after the first live visit: "it opened the hevyd window but didn't start
# the claude session. i feel like it should start the session and onboard too."
# That overrides v0's no-launch decision (sb6s), and the way it lands matters:
#
# THE HALL STILL NEVER TYPES. It shells out to agents/scheduler/pulse-inject.sh
# — the fleet's one injection primitive — and the INJECTOR types, into a window
# it launched. test-hall.sh's no-send-keys assertion is unchanged and still
# passes, because it is still true.
#
# Reusing the injector rather than growing a second launcher buys, for free:
# the tap export plus /proc verification (never silently on the wrong seat),
# the d0bk roster model pin, the readiness gate and bounce discipline, and the
# ledger. Everything that has already been argued and tested once.
#
# ONLY ON MATERIALIZATION. A warm window is switched to and nothing else: a
# seat that is already running is NOT re-onboarded, because /onboard into a
# live session is a context reset nobody asked for.
#
# DETACHED, because the injector waits for the composer to report input-ready
# (up to 90s) and a popup that hangs that long is a broken popup. The verdict
# line goes to $HALL_LAUNCH_LOG, which is where to look when a launch does not
# land.
#
# THE SOCKET travels in $TMUX. pulse-inject.sh has no -S flag (it is a caller
# here, not a thing to edit), and tmux reads the socket path from $TMUX when no
# -S is given — measured. So the launch is bound to the same server the hall is
# acting on, rather than to whatever the ambient default server happens to be.
#
# Seams: HALL_NO_LAUNCH=1 / --no-launch (materialize only), HALL_INJECT (the
# injector path), HALL_LAUNCH (forwarded as the injector's own --launch, which
# is how the suite runs an inert launcher), HALL_LAUNCH_LOG.
hall_launch() {
  local seat=$1 home=$2 sess=$3 dump=$4
  local inject log tap cfg default_cfg args

  [ "${HALL_NO_LAUNCH:-0}" = 1 ] && {
    printf 'hall: --no-launch: %s materialized, nothing started.\n' "$seat" >&2
    return 0
  }

  inject=${HALL_INJECT:-"$HERE/../scheduler/pulse-inject.sh"}
  [ -f "$inject" ] || {
    printf 'hall: cannot find pulse-inject.sh at %s — %s materialized but NOT launched.\n' \
      "$inject" "$seat" >&2
    return 1
  }
  log=${HALL_LAUNCH_LOG:-/tmp/hall-launch.log}

  args=(--dir "$home" --session "$sess" --window "$seat" --cmd '/onboard'
        --loop "hall-visit-$seat")

  # THE TAP, and why a personal seat gets NO --config-dir. The flag's job is to
  # move a launch OFF the default seat; asserting the default one only adds
  # failure modes (a missing credential file becomes exit 78, and a warm pane
  # on no explicit seat becomes failed-wrong-seat) in exchange for nothing.
  # So: pass it when the seat's tap points somewhere else, never otherwise.
  tap=$(printf '%s\n' "$dump" | awk -F'\t' -v s="$seat" '$1=="seat" && $2==s {print $10; exit}')
  if [ -n "$tap" ]; then
    cfg=$(hall_expand_home "$(_seat_tap_config_dir "$tap" "$dump")")
    default_cfg=$(hall_expand_home "${CLAUDE_CONFIG_DIR:-~/.claude}")
    if [ -n "$cfg" ] && [ "$cfg" != "$default_cfg" ]; then
      args+=(--config-dir "$cfg")
    fi
  fi
  [ -n "${HALL_LAUNCH:-}" ] && args+=(--launch "$HALL_LAUNCH")

  {
    printf '=== %s hall visit: seat=%s session=%s window=%s tap=%s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$seat" "$sess" "$seat" "${tap:--}"
  } >> "$log"
  # nohup + & : the hall returns to the popup immediately; the injector lives
  # on past it. Its stdout carries the PULSE_INJECT_RESULT verdict line.
  nohup env TMUX="$5,0,0" bash "$inject" "${args[@]}" >> "$log" 2>&1 &
  printf 'hall: launching %s (%s) — verdict in %s\n' "$seat" "${tap:-personal}" "$log" >&2
  return 0
}

visit() {
  local want=$1 dump hit match seat row sock sess home office sigil win_id created=0
  dump=$(_seat_dump) || die 3 "roster could not be read (see the parse error above)."

  hit=$(_seat_lookup "$want" "$dump") || { hall_near "$want" "$dump"; exit 2; }
  match=${hit%%$'\t'*}
  seat=${hit#*$'\t'}
  [ "$match" = alias ] && \
    printf 'hall: %s is an ALIAS of seat %s (the roster is what makes the rename survivable).\n' \
      "'$want'" "'$seat'" >&2

  row=$(_seat_row "$seat" "$dump") || die 3 "seat '$seat' vanished from the roster mid-read"
  home=$(printf '%s' "$row" | cut -f5)
  office=$(printf '%s' "$row" | cut -f7)
  sigil=$(printf '%s' "$row" | cut -f8)
  home=$(hall_expand_home "$home")

  sock=$(hall_socket) || die 1 "no tmux socket in view (no \$TMUX, no default server). Start tmux first."
  tmux_e "$sock" list-sessions >/dev/null 2>&1 || die 1 "no tmux server on $sock"

  sess=$(hall_target_session "$seat" "$dump" "$sock") || \
    die 1 "cannot determine which session seat '$seat' belongs in"
  tmux_e "$sock" has-session -t "=$sess" 2>/dev/null || \
    die 1 "session '$sess' does not exist on $sock — attach (or let the session-created hook run) first; the hall does not invent sessions"

  local aliases
  aliases=$(printf '%s\n' "$dump" | awk -F'\t' -v s="$seat" '$1=="alias" && $3==s {print $2}' | tr '\n' ' ')
  # $aliases is a deliberate word list of R1 names, so the split is the point.
  # NOTE the directive's shape: a trailing `-- why` made shellcheck 0.10 refuse
  # to parse the DIRECTIVE (SC1072/SC1073, a fatal error), which aborts the
  # whole file — so nothing in this script was being checked at all. The
  # rationale goes above the directive; the directive line stays bare.
  # shellcheck disable=SC2086
  win_id=$(hall_find_window "$sock" "$sess" "$seat" $aliases)

  if [ -n "$win_id" ] && [ "${HALL_ONLY_IF_ABSENT:-0}" = 1 ]; then
    printf 'hall: %s already has a window in session %s — leaving it alone (HALL_ONLY_IF_ABSENT).\n' \
      "$seat" "'$sess'" >&2
    return 0
  fi

  if [ -z "$win_id" ]; then
    [ -d "$home" ] || die 1 "seat '$seat' home '$home' does not exist — fix the roster or the directory; the hall will not materialize a seat in the wrong place"
    win_id=$(tmux_e "$sock" new-window -d -P -F '#{window_id}' -t "=$sess" -n "$seat" -c "$home") \
      || die 1 "could not create the window for seat '$seat' in session '$sess'"
    created=1
    # …and now it is launched, through the injector (dotfiles-dsbl). v0 stopped
    # here on purpose — "an empty shell in the right place is the correct v0
    # answer" — and Zig overruled that from the first live visit: a seat you
    # visit should be a seat that is awake.
    hall_launch "$seat" "$home" "$sess" "$dump" "$sock" || true
  fi

  tmux_e "$sock" select-window -t "$win_id" >/dev/null 2>&1 || true
  if [ -n "$(tmux_e "$sock" list-clients -F '#{client_name}' 2>/dev/null)" ]; then
    tmux_e "$sock" switch-client -t "=$sess" >/dev/null 2>&1 || true
  fi

  if [ "$created" = 1 ]; then
    printf '%s  %s %s %s %s materialized in session %s, window %s, cwd %s\n' \
      "$sigil" "$seat" "$SEP" "$office" "$SEP" "'$sess'" "'$seat'" "$home"
  else
    printf '%s  %s %s %s %s session %s, window %s\n' \
      "$sigil" "$seat" "$SEP" "$office" "$SEP" "'$sess'" "'$seat'"
  fi
}

usage() {
  cat <<EOF
hall — the court view of the estate (v0, bead dotfiles-sb6s)

  hall                 the COURT VIEW: every seat, its office, status, last
                       activity, model and tap, plus any UNREGISTERED window
  hall <seat|alias>    visit a seat: switch to its window, or materialize it
                       (roster session, roster home, canonical name) and LAUNCH
                       it — claude + /onboard, through pulse-inject.sh. A window
                       that already exists is switched to and left alone.
  hall --no-launch <s> materialize/switch only (also: HALL_NO_LAUNCH=1)
  hall home            the front desk (alias for: hall seneschal)
  hall --interactive   court + a seat> prompt (the popup mode). The prompt takes
                       a bare seat name, 'hall <seat>', 'home' or 'hall home' —
                       all the same thing. Enter on an empty line closes, and so
                       do Esc and Ctrl-C; backspace edits the whole line and an
                       arrow key does nothing. The court repaints while it is
                       open (HALL_REFRESH_SECS, 0 disables), and stops repainting
                       while there is anything typed.
  hall --help          this

The court is RESPONSIVE: it reads its own width (COLUMNS, else tput cols, else
80) and renders compact below 60 columns (a phone: sigil, name, status), the
full table to 99, and at 100+ adds each seat's charter line. COMPACT SHOWS LIVE
SEATS ONLY — an asleep seat is one line of phone you cannot act on; type its
name to wake it. Every wider layout draws the whole roster.

The tap column reads the estate's tap POLICY: the seat's tap in epoch-3 naming,
and 'primary${TAP_ARROW}secondary' when agents/scheduler/taps.conf gives
that seat a different home pool. It is the PREFERRED tap, not the serving one.

The roster (agents/seats.yml) is truth; windows are cache. The hall reads the
roster, the live tmux server and taps.conf — all local, no harnessd, so the
cockpit outlives the daemon. Mail, brief, marshal queue, adopt/retire and the
SERVING tap are still v1.
EOF
}

# hall_prompt_seat <typed line> -> the seat to visit, on stdout.
#
# EVERY FORM ZIG MIGHT TYPE MEANS THE SAME THING (dotfiles-hnhl). The old
# footer said "hall <seat> to visit", which reads as an instruction to type
# those exact words; Zig typed a bare seat name instead. Both were right, so
# both work, plus `home` and `hall home`. Surrounding whitespace is eaten
# because a phone keyboard adds a trailing space after a word.
#
# It NEVER invents a seat: anything that is not one of these shapes comes back
# unchanged and goes to visit(), which is the one place allowed to refuse.
hall_prompt_seat() {
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}          # ltrim
  s=${s%"${s##*[![:space:]]}"}          # rtrim
  case "$s" in
    hall\ *) s=${s#hall }; s=${s#"${s%%[![:space:]]*}"} ;;
  esac
  case "$s" in home) s=seneschal ;; esac
  printf '%s' "$s"
}

# The popup mode (Zig, 2026-08-09 — he typed a seat name into the court
# expecting a visit; that instinct is the UX): render the court, then hold a
# `seat>` prompt. A seat name (or alias, or `home`, or the `hall <seat>` form)
# visits it — switch-client works from inside a display-popup because popups
# inherit the server's $TMUX (the sessionizer pattern). Empty Enter, a single
# ESC, EOF, or an unknown name after the retry just closes. Lives HERE and not
# in tmux.conf because tmux expands $vars in double-quoted config strings at
# source time.
#
# ---------------------------------------------------------------------------
# ONE RAW LOOP OWNS THE BUFFER (dotfiles-hnhl, Zig on his phone AND his desktop)
# ---------------------------------------------------------------------------
# The first cut read the line in TWO PHASES — one raw `read -rsn1` for the first
# keystroke (so ESC could close), then a blocking `read -r` for the rest. That
# split is the root cause of three separate bugs Zig hit live on 2026-08-09, and
# no patch to either phase could have fixed them, because each is a consequence
# of the line-editor owning only PART of the input:
#
#   1. THE FIRST CHARACTER WAS UNDELETABLE. The line read's editor cannot erase a
#      byte it never read, so backspace stopped at the raw-read char and the
#      buffer could never return to empty — and an empty buffer is what Enter
#      needs to close the popup.
#   2. ESC MID-BUFFER TYPED INSTEAD OF CLOSING. Only the first keystroke was ever
#      compared against ESC; after that the \e byte went into the line read as
#      text. "The key everyone reaches for" worked exactly once per prompt.
#   3. ANY ARROW KEY ON AN EMPTY BUFFER CLOSED THE POPUP. An arrow is ESC [ A —
#      three bytes — and the bare \e matched the close case before the other two
#      had arrived. Nudging the cursor dismissed the court.
#
# So the loop below reads EVERY keystroke raw and holds the buffer itself:
#
#   printable      append to the buffer, echo it
#   backspace/DEL  erase one char and '\b \b' over it; AT EMPTY IT IS A NO-OP —
#                  never a close, so backspace can always walk you back to the
#                  empty buffer that Enter closes on (bug 1)
#   Enter          empty buffer closes; otherwise SUBMIT (the visit is unchanged,
#                  including the subshell that survives a typo)
#   Esc            drained: MORE bytes means an escape SEQUENCE (arrow, Home, a
#                  function key) which is swallowed WHOLE and ignored (bug 3);
#                  NO bytes means the bare Esc key, which closes ALWAYS —
#                  buffer or no buffer (bug 2)
#   Ctrl-C         closes cleanly (the byte, and the signal via a trap)
#
# `read -rsn1` needs no tty. With stdin on a pipe or a here-string (tests, `echo
# x | hall --interactive`) bash still returns one byte at a time, so the same
# path works; only the terminal echo is missing, which is why we echo it
# ourselves — and which is what makes every one of these behaviours testable
# from a byte string on stdin.
#
# ---------------------------------------------------------------------------
# IT REFRESHES WHILE IT IS OPEN (Zig, 2026-08-09: "immensely better for
# watching").  The prompt loop is a WATCH loop: the keystroke read carries a
# timeout, and a timeout repaints.  The two sources are the two cheap ones the
# court already reads — the roster and `list-windows` — so a tick costs a
# fraction of a second, and 🧠 -> ✅ -> 🔔 becomes something you can watch
# happen.
#
# NO FLICKER: the frame is built OFF-SCREEN into a string, then written in ONE
# printf, positioned with ANSI home.  Each line clears to end-of-line and the
# frame ends with clear-to-end-of-screen, so a court that SHRINKS (a window
# closed, an unregistered row gone) does not leave the old rows behind.  A
# clear-then-draw would flicker; this cannot, because the terminal never sees a
# blank state.
#
# REFRESH SUSPENDS THE MOMENT TYPING STARTS and RESUMES WHEN THE BUFFER EMPTIES.
# The mechanism used to be the two-phase read itself (only the first keystroke
# had a timeout); with one loop it is stated instead of implied — the read
# carries a timeout only while the buffer is EMPTY.  That is strictly better
# than the old accident: backspacing away a half-typed name puts you back in
# watch mode, where the old code left you blocked until Enter.  Zig's note
# offered two options — reprint the typed prefix after each frame, or suspend on
# the first character — and this is the second, because the first has a race it
# cannot win (a repaint between the keystroke and the reprint eats the
# character) and because a court that freezes while you are naming a seat is the
# correct behaviour anyway: you are no longer watching, you are steering.  A
# repaint still reprints the prompt AND the buffer, so the invariant holds even
# if that policy is ever loosened.
#
# HALL_REFRESH_SECS tunes it; 0 or empty disables the refresh entirely and the
# loop goes back to a plain blocking read.
hall_paint() {
  local frame=$1 out line
  out=$'\033[H'
  while IFS= read -r line; do out+="$line"$'\033[K\n'; done <<<"$frame"
  out+=$'\033[J'
  printf '%s' "$out"
}

# hall_esc_seq — an ESC byte has just been read.  Returns 0 when it OPENED AN
# ESCAPE SEQUENCE (which this function has now swallowed entirely, so the caller
# ignores the whole thing), 1 when it was the BARE Esc key.
#
# The distinction is timing and nothing else: a terminal sends the bytes of an
# arrow key back to back, a human's Esc arrives alone.  So one short-timeout
# read decides it, and when a sequence HAS started the rest is consumed by its
# actual grammar — CSI/SS3 parameter bytes up to and INCLUDING the final byte —
# rather than by draining "everything available", which would also swallow the
# next real keystroke on a fast pipe.  That precision is what lets bug 3's
# regression test (two arrows, then a name, then Enter) mean anything.
#
# HALL_ESC_DRAIN is the seam: raise it if a link is ever slow enough to split an
# arrow key's three bytes across the window, which would read as a bare Esc.
hall_esc_seq() {
  local b
  IFS= read -rsn1 -t "${HALL_ESC_DRAIN:-0.01}" b || return 1
  case "$b" in
    '['|'O')
      while IFS= read -rsn1 -t "${HALL_ESC_DRAIN:-0.01}" b; do
        case "$b" in
          [0-9]|';'|'?'|'<'|'='|'>'|':') continue ;;   # parameter bytes
          *) break ;;                                  # the final byte (or a stray)
        esac
      done ;;
    # Anything else after ESC is an Alt-<key> or a stray byte: the ESC and that
    # one byte are swallowed together, and nothing is typed.
  esac
  return 0
}

interactive() {
  local _c _buf='' _seat _rc _refresh
  _refresh=${HALL_REFRESH_SECS-2}
  case "$_refresh" in ''|0|*[!0-9.]*) _refresh='' ;; esac
  # Ctrl-C closes cleanly rather than leaving the popup's shell to die mid-frame.
  trap 'printf "\n"; exit 0' INT
  hall_paint "$(court)"
  printf 'seat> '
  while :; do
    # THE TIMEOUT IS THE WATCH LOOP, and it is armed only while the buffer is
    # empty: a court that repaints under your fingers is a court you cannot type
    # into.
    if [ -n "$_refresh" ] && [ -z "$_buf" ]; then
      IFS= read -rsn1 -t "$_refresh" _c; _rc=$?
      # bash: >128 is the TIMEOUT, 1 is EOF. Only the timeout repaints; EOF
      # still closes, or a `printf x | hall --interactive` would spin forever.
      if [ "$_rc" -gt 128 ]; then
        printf '\r'
        hall_paint "$(court)"
        printf 'seat> %s' "$_buf"
        continue
      fi
      [ "$_rc" -eq 0 ] || { printf '\n'; return 0; }
    else
      IFS= read -rsn1 _c || { printf '\n'; return 0; }
    fi
    case "$_c" in
      $'\e')
        # A SEQUENCE is swallowed whole and ignored (bug 3); the BARE Esc key
        # closes ALWAYS, with or without a buffer (bug 2).
        hall_esc_seq && continue
        printf '\n'; return 0 ;;
      ''|$'\n'|$'\r')
        # `read -n1` returns the EMPTY string for the newline delimiter, so ''
        # IS Enter here — not "no key".
        [ -n "$_buf" ] || { printf '\n'; return 0; }
        printf '\n'
        _seat=$(hall_prompt_seat "$_buf")
        _buf=''
        [ -n "$_seat" ] || return 0
        # Subshell: visit exit-2s (die) on an unknown seat, which would close the
        # popup mid-typo — the subshell absorbs the exit so the prompt survives.
        if (visit "$_seat"); then return 0; fi
        # visit already printed near-matches on stderr; prompt for another try
        printf 'seat> ' ;;
      $'\177'|$'\b')
        # AT EMPTY IT IS A NO-OP — not a close, and never an erase into the
        # prompt itself (bug 1).
        [ -n "$_buf" ] || continue
        _buf=${_buf%?}
        printf '\b \b' ;;
      $'\003')
        printf '\n'; return 0 ;;
      [[:cntrl:]])
        # Every other control byte is ignored rather than buffered: a raw \t or
        # \f in the buffer is a seat name no roster can hold and a prompt line
        # the terminal draws wrong.
        : ;;
      *)
        _buf="$_buf$_c"
        printf '%s' "$_c" ;;
    esac
  done
}

main() {
  # --no-launch is a MODIFIER, not a verb: it may precede any of them, and it
  # is the same switch as HALL_NO_LAUNCH=1 (the env form is what the attach
  # hook uses, since a tmux hook line cannot pass flags through as readably).
  if [ "${1:-}" = --no-launch ]; then
    HALL_NO_LAUNCH=1; export HALL_NO_LAUNCH; shift
  fi
  case "${1:-}" in
    ''|court)        court ;;
    -h|--help|help)  usage ;;
    --interactive)   interactive ;;
    home)            visit seneschal ;;
    -*)              printf 'hall: unknown option %s\n' "'$1'" >&2; usage >&2; exit 2 ;;
    *)
      [ $# -gt 1 ] && { printf 'hall: one seat at a time (got: %s)\n' "$*" >&2; exit 2; }
      visit "$1" ;;
  esac
}

main "$@"
