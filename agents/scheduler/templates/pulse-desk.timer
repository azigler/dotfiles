# Timer: the explore lab's ALLOCATOR loop (`/desk`), weekly Friday 10:00
# America/Los_Angeles. Successor to `pulse-elevate.timer` (rename decision
# 2026-07-26, bead explore-mqvu; transition constraints explore-b47q).
# Schedule is IDENTICAL to the timer it replaces — a rename, not a cadence change.
# It sits between the 06:00 and 12:00 dive fires so the two loops never overlap.
#
# NOT INSTALLED. Installing it is a LIVE pulse-schedule change and needs Zig's
# confirmation (dotfiles-q702). Install sequence, in this order:
#   1. land the /desk skill + the explore refs/pulse.md `desk` row + the
#      "Archived rows" table (which keeps the historical `elevate` ledger rows
#      linting clean) FIRST
#   2. systemctl --user disable --now pulse-elevate.timer
#   3. mv the stamp so the renamed timer inherits its run history and does NOT
#      fire a phantom catch-up tick (agents/infra.md "Timer-rename gotcha"):
#      mv ~/.local/share/systemd/timers/stamp-pulse-elevate.timer \
#         ~/.local/share/systemd/timers/stamp-pulse-desk.timer
#   4. install these two units, `systemctl --user daemon-reload`,
#      `systemctl --user enable --now pulse-desk.timer`
#   5. update ~/harnessd/refs/harness-manifest.json in the SAME change
#      (timer + ledger_row), or the dashboard reports a phantom stale loop
#   6. verify: systemd-analyze calendar 'Fri *-*-* 10:00:00 America/Los_Angeles'
#
# explore-b47q: the old elevate pulse is ARCHIVED, not migrated. Its ledger rows
# stay under `"row":"elevate"` as history; `desk` starts a FRESH row.
[Unit]
Description=Pulse timer: weekly /desk pass (explore lab resourcing memo)

[Timer]
OnCalendar=Fri *-*-* 10:00:00 America/Los_Angeles
Persistent=true

[Install]
WantedBy=timers.target
