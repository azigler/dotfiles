# Pulse timer: digest — every morning 07:00 PT (Neuron has landed; prior-day Simon complete)
# Renamed from pulse-daily-digest.timer 2026-07-27 (explore-8tit) so the unit
# stem matches the ledger row, per the fleet convention. Live since 2026-06-24.
[Unit]
Description=Pulse timer: digest

[Timer]
OnCalendar=*-*-* 07:00:00 America/Los_Angeles
# Fire on next boot if the machine slept through the window:
Persistent=true

[Install]
WantedBy=timers.target
