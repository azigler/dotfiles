# Timer: claude-vault hourly bidirectional sync. This template is SHARED, not
# peer-only. Only zig-computer (the primary, minute :00) runs it today; the peer
# that ran at minute :15 was marketing-vps, decommissioned 2026-08-07.
# ⚠️ The OFFSET RULE survives the peer: any two machines running this must fire at
# different minutes, or they clobber each other's push. Set the minute per-machine
# at install time (the line below is the primary's).
# Enable with:  systemctl --user enable --now claude-vault-sync.timer
[Unit]
Description=Hourly claude-vault bidirectional sync

[Timer]
OnCalendar=*-*-* *:00:00
Persistent=true

[Install]
WantedBy=timers.target
