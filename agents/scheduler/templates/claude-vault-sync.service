[Unit]
Description=claude-vault bidirectional sync — hourly PULL+push of memory + transcripts
# spec lin-i2d.1 P5. PULLS latest for both vaults first (so an idle machine still
# syncs down the other machine's changes), then pushes local via the guarded
# functions. LLM-free, deterministic. Inert until the vaults are bootstrapped.
#
# EXIT CODES (dotfiles-t6sd) — this unit reported 0/SUCCESS through 120
# consecutive runs whose transcripts push was blocked by the Layer-1 secret gate,
# so five days of dead backups looked healthy. vault-sync.sh now propagates:
#   0   healthy — every bootstrapped tier reached the remote
#   1x  DEGRADED — a tier failed this run
#   2x  STALE    — a failing tier has not succeeded in >= 6h (VAULT_SYNC_STALE_HOURS)
#   ...units digit: x0 transcripts only | x1 memory only | x2 both
# So status=10 is "transcripts degraded, memory fine"; status=21 is "memory stale".
# Do NOT add SuccessExitStatus= — nonzero MUST redden the unit. stdout/stderr stay
# redirected to the log file (the secret scanner's per-file report is verbose and
# must not flood the journal); the script journals ONLY its one-line verdict via
# systemd-cat, which is what makes `systemctl status` legible without the log.
#
# SCRUB-AND-CONTINUE (dotfiles-t6sd, 2026-07-26). A secret in vault-bound content
# is now REDACTED in place and the push continues, instead of the fail-closed gate
# stalling the vault. Such a run is still exit 0 and the unit stays GREEN — by
# policy it behaved correctly — but it is deliberately NOT indistinguishable from
# a clean run:
#   journalctl -t vault-sync -p notice    # every run that scrubbed a credential
#   jq -c 'select(.scrub>0)' ~/.claude/vault-sync-ledger.jsonl
#   ~/.claude/vault-redactions.jsonl      # tier / action / path / pattern names
# The verdict line also carries a `scrub=[redacted=N deferred-live=M]` term.

[Service]
Type=oneshot
ExecStart=/usr/bin/env bash %h/dotfiles/agents/vault/vault-sync.sh
TimeoutStartSec=1800
StandardOutput=append:%h/.claude/vault-sync.log
StandardError=append:%h/.claude/vault-sync.log
