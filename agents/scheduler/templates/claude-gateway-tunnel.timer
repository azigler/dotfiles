# Timer: keep marketing-vps's 17017 forward to pico's agentgateway alive.
# marketing-vps ONLY (zig-computer and metis are tailnet peers and dial the
# gateway directly; they need no tunnel and must not run this).
#
# Install — the VPS is a READ-ONLY consumer of dotfiles, so this file arrives by
# `vps-repo-refresh` fast-forwarding ~/dotfiles, and is then COPIED (not
# symlinked) into the user unit dir, exactly as pulse-* and claude-vault-sync are:
#   cp ~/dotfiles/agents/scheduler/templates/claude-gateway-tunnel.service \
#      ~/dotfiles/agents/scheduler/templates/claude-gateway-tunnel.timer \
#      ~/.config/systemd/user/
#   loginctl show-user "$USER" -p Linger      # MUST be Linger=yes, see below
#   systemctl --user daemon-reload
#   systemctl --user enable --now claude-gateway-tunnel.timer
# A copy means a later dotfiles change does NOT reach the box until someone
# re-copies — the same standing caveat pulse-dive.timer carries.

[Unit]
Description=Tick: ensure the pico agentgateway tunnel on 127.0.0.1:17017

[Timer]
Unit=claude-gateway-tunnel.service

# BOOT. The tunnel must exist after a reboot, not only after the first periodic
# tick, and nothing else on the box will open it. Both settings are here on
# purpose and are not redundant:
#   OnBootSec=    relative to SYSTEM boot — the case that matters when the user
#                 manager is started at boot by lingering.
#   OnStartupSec= relative to the USER MANAGER starting, which without lingering
#                 is first login, long after boot. Without this the timer would
#                 sit until the first OnUnitActiveSec interval elapsed.
# ⚠️ Lingering is the real prerequisite: with `Linger=no` the user manager (and
# with it this timer AND the ssh forward, which lives in the service's cgroup)
# goes away when the last session ends. The box already runs always-on user
# timers, so it is presumably already on — verify, do not assume.
OnBootSec=30s
OnStartupSec=30s

# CADENCE: every 2 minutes, matching lb-granola-pull, the fastest cadence this
# box is already known to tolerate. A healthy tick is one curl to loopback and an
# exit — the script no-ops when the port already answers 401 and never churns a
# healthy socket, so frequency is nearly free.
#
# THE GAP, STATED HONESTLY: this is a poller, so there is a window in which the
# tunnel is dead and nothing has noticed. A `claude` launched in that window —
# or an in-flight session's next request — fails hard, with no fallback
# (dotfiles-ucl4). Worst case with these settings:
#     120s (a death just after a tick) + 15s (AccuracySec) + 10s (the probe's own
#     curl -m 10 on a bound-but-dead socket) + ~5s (ssh reconnect + re-probe)
#     ~= 2.5 minutes of hard failure.
# Faster would shrink it, at the cost of a wakeup every N seconds forever; 2.5
# minutes of a dead LLM endpoint on an unattended box is the accepted trade. If
# it turns out to bite, the lever is this file, not the script.
OnUnitActiveSec=2min

# Default AccuracySec is 1min, which would silently make a "2 minute" timer fire
# up to 3 minutes late and widen the window above by half. This is a cheap
# loopback probe on an always-on VPS; buy the precision.
AccuracySec=15s

# NO RandomizedDelaySec. Jitter exists to spread load against a shared upstream
# (vps-repo-refresh uses 300s against GitHub). Here the "upstream" is a local
# socket, and jitter would only widen the failure window.
#
# NO Persistent=true. It applies ONLY to calendar timers — it replays a missed
# OnCalendar fire. On a purely monotonic timer it is a no-op that READS like
# protection, and boot coverage is already handled by OnBootSec/OnStartupSec
# above. (pulse-retry.timer sets it alongside monotonic settings; that is the
# no-op, not a precedent.)

[Install]
WantedBy=timers.target
