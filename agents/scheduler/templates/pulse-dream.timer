# Timer: /dream weekly — Sunday 04:13 America/Los_Angeles (off-peak, off the
# :00/:30 marks, away from the daily noon-PT `dive` tick). Weekly suits a loop that
# consolidates "sessions since its last run."
#
# ENABLED. Renamed 2026-07-27 (explore-w1mn) from pulse-recall-distill.timer; the
# SCHEDULE IS UNCHANGED by that rename — it fired 07-13, 07-19 and 07-26 under the
# old name and keeps this slot. Re-enable after a reinstall with:
#   systemctl --user enable --now pulse-dream.timer
[Unit]
Description=Weekly dream learning-loop tick

[Timer]
OnCalendar=Sun *-*-* 04:13:00 America/Los_Angeles
Persistent=true

[Install]
WantedBy=timers.target
