# Timer: pulse stall reconciler — every 10 minutes. Cheap (a few `systemctl show` calls
# plus tail-reads of the ledgers) and no-ops silently whenever every loop has reported.
#
# 10 min, not 2: this watcher writes a PERMANENT ledger row, so its latency budget is
# "noticed within a dashboard refresh or two", not "the instant it happens". The script
# additionally waits grace_minutes + 30 before calling any fire dead, so polling faster
# would buy nothing.
[Unit]
Description=Pulse stall reconciler timer (every 10 min)

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
# Fire on next boot if the machine slept through a window:
Persistent=true

[Install]
WantedBy=timers.target
