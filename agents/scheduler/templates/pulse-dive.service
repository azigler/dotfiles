# Pulse tick: `/dive` — the explore lab's EXECUTOR (Vibes research loop;
# dotfiles-mhn, ~/explore/refs/pulse.md row `dive`). Successor to
# pulse-explore.service (rename 2026-07-26, explore-mqvu).
#
# tmux WINDOW IS DELIBERATELY UNCHANGED. Zig sits in these windows; renaming one
# is a separate, Zig-gated step (explore-b47q item 1). If/when the window is
# renamed `dive`, change `--window explore` below AND the identity key in
# ~/explore/.claude/identity.yml AND expect the per-window handoff file to move
# from refs/session-handoff--explore.md to refs/session-handoff--dive.md.
#
# Inspect runs: journalctl --user -u pulse-dive.service -n 20
[Unit]
Description=Pulse tick: dive (tmux-injection into the explore window)

[Service]
Type=oneshot
ExecStart=%h/dotfiles/agents/scheduler/pulse-inject.sh --loop %p --fresh --dir %h/explore --session work --window explore --cmd "/pulse tick"
