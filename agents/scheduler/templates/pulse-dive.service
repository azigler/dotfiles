# Pulse tick: `/dive` — the explore lab's EXECUTOR (Vibes research loop;
# dotfiles-mhn, ~/explore/refs/pulse.md row `dive`). Successor to
# pulse-explore.service (rename 2026-07-26, explore-mqvu).
#
# WINDOW ROTATION COMPLETE (2026-07-26, Zig's call). The tmux window was renamed
# explore -> dive, so this unit injects into `--window dive`. Rotated with it:
# the identity key in ~/explore/.claude/identity.yml, the per-window handoff file
# (refs/session-handoff--explore.md -> --dive.md), the learning loop that then
# shared this window, and the now-deleted pulse-explore.{service,timer}.
# That learning loop has since LEFT: on 2026-07-27 (explore-w1mn)
# pulse-recall-distill.service was renamed pulse-dream.service and repointed to
# its own `dream` window, so `dive` is now this unit's alone.
# harnessd's manifest needed NO change — its `key` is a project slug keyed on
# path, not a tmux window name.
#
# Inspect runs: journalctl --user -u pulse-dive.service -n 20
[Unit]
Description=Pulse tick: dive (tmux-injection into the dive window)

[Service]
Type=oneshot
ExecStart=%h/dotfiles/agents/scheduler/pulse-inject.sh --loop %p --fresh --dir %h/explore --session work --window dive --cmd "/pulse tick"
