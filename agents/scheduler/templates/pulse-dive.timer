# Timer: the explore lab's EXECUTOR loop (`/dive`), 1x/day at 12:00
# America/Los_Angeles. Successor to `pulse-explore.timer` (rename decision
# 2026-07-26, bead explore-mqvu); INSTALLED and enabled since that rename.
#
# Cadence history: 1×/day → 3×/day (2026-06-29) → 4×/day every 6h at
# 00/06/12/18 PT (2026-07-13) → **1×/day at 12:00 PT (2026-07-29, Zig's call)**.
# The matching daily cap in ~/explore/refs/pulse.md moved 4/day → 1/day with it —
# cap always equals the fire count, so it only ever stops a double-fire in one
# slot, never a legitimate tick.
#
# Editing this file is a LIVE pulse-schedule change (dotfiles-q702) — it needs
# Zig's confirmation, and the installed copy at
# ~/.config/systemd/user/pulse-dive.timer is a COPY, not a symlink, so both must
# be edited and then `systemctl --user daemon-reload && systemctl --user restart
# pulse-dive.timer`.
#
# ⚠️ Persistent=true catch-up: restarting the timer after a schedule edit fires
# an immediate catch-up tick if a slot has elapsed since the last run. Check
# `systemctl --user list-timers pulse-dive.timer` (LAST) against the new slot
# before restarting, and expect one off-cadence tick if a slot did elapse.
#
# Verify: systemd-analyze calendar '*-*-* 12:00:00 America/Los_Angeles'
[Unit]
Description=Pulse timer: dive (explore lab executor — Vibes research tick)

[Timer]
# Once a day at noon PT (1 fire/day).
OnCalendar=*-*-* 12:00:00 America/Los_Angeles
# Fire on next boot if the machine slept through a window:
Persistent=true

[Install]
WantedBy=timers.target
