[Unit]
Description=restart-loop check tick
Documentation=file:///home/ubuntu/dotfiles/agents/bin/restart-loop-check.sh

[Timer]
# Weekly, not daily. A restart loop is a slow, cheap-to-detect condition that
# persists until someone fixes it — the three found in 2026-07 had each been
# running for ~2 months. Daily would add noise without shortening the window
# meaningfully, and this check costs two ssh round-trips 15s apart.
# Sunday, off-hour and off-minute like the rest of the fleet.
OnCalendar=Sun *-*-* 07:41:00
RandomizedDelaySec=900

# Persistent: a missed tick means the thing watching for silent loops was
# itself silent. Catch it up.
Persistent=true
Unit=restart-loop-check.service

[Install]
WantedBy=timers.target
