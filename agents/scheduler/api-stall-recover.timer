[Unit]
Description=api stall recovery tick
Documentation=file:///home/ubuntu/dotfiles/agents/scheduler/api-stall-recover.sh

[Timer]
# Every 2 minutes, on ODD minutes at :11 seconds — deliberately ONE MINUTE AFTER
# gateway-health.timer, which runs the even minutes at the same offset.
#
# THE OFFSET IS THE DESIGN, not tidiness. This guard's first act is to probe the
# same upstream gateway-health repairs, and it touches nothing while that probe
# fails — so running it a minute behind means a restored gateway is already back
# by the time the panes are examined, and a restart in flight simply produces a
# quiet `upstream-down` tick that costs one curl. Restore first, then recover.
#
# Hence also RandomizedDelaySec=0. A random smear on either timer would let a
# recovery tick overtake the restore it depends on and nudge every stalled seat
# straight into a gateway that is still down: each one re-errors, each one burns
# its 15-minute cooldown, and the outage gets LONGER because of the guard.
OnCalendar=*-*-* *:1/2:11
RandomizedDelaySec=0
# AccuracySec pins the fire to the scheduled second — systemd's default is a
# one-minute coalescing smear, which is RandomizedDelaySec by another name and
# breaks the restore-then-recover offset the same way (see gateway-health.timer).
AccuracySec=1s

# NOT Persistent. A catch-up buys nothing on a 2-minute cadence, and after a
# suspend or a long boot it would fire into a tmux server whose panes have not
# finished coming back.
Persistent=false
Unit=api-stall-recover.service

[Install]
WantedBy=timers.target
