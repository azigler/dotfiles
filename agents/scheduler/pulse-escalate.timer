# Timer: the pulse escalation ladder — every 5 minutes.
#
# Slower than pulse-retry's 2 minutes on purpose. That watcher is a low-latency poll for
# a 🔔 that has ALREADY cleared (acting late costs a delayed tick); this one ACTS on a
# human — renaming a window, injecting into the front desk, filing a P1 bead, buzzing a
# phone. The clocks that matter here are escalate.conf's grace_minutes and
# cooldown_minutes, both far longer than the poll, so a faster tick would buy latency
# nobody needs and add runs that can only decide to do nothing.
#
# NOT ENABLED until Zig confirms go-live:
#   systemctl --user daemon-reload && systemctl --user enable --now pulse-escalate.timer
[Unit]
Description=Pulse escalation ladder timer (poll bounced critical loops every 5 min)

[Timer]
# Poll shortly after boot, then every 5 minutes while the machine is up.
OnBootSec=5min
OnUnitActiveSec=5min
# Fire on next boot if the machine slept through a window:
Persistent=true

[Install]
WantedBy=timers.target
