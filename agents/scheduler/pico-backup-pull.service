# The keep's off-box pull of pico's un-backed-up state (dotfiles-1x4g).
# See pico-backup-pull.sh's header for what is pulled, what is deliberately not,
# and why the direction is keep-pulls rather than pico-pushes.
#
# Pair with pico-backup-pull.timer. Install (machine-local; the repo is the
# source of truth, ~/.config/systemd/user holds the running copy):
#
#   cp agents/scheduler/pico-backup-pull.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now pico-backup-pull.timer
#   systemctl --user list-timers pico-backup-pull.timer
#
# Inspect: journalctl --user -u pico-backup-pull.service -n 60
#   ...but the keep's user journal holds roughly six hours (dotfiles-9h8n), so
#   the durable trail is the ledger:
#   tail -3 ~/.local/share/fleet-health/pico-backup.jsonl
#
# The last line of every run is PICO_BACKUP_PULL_RESULT=<ok|degraded|unreachable>.

[Unit]
Description=pico backup pull — the keep takes pico's un-backed-up state off pico's disk
Documentation=file:///home/ubuntu/dotfiles/agents/scheduler/pico-backup-pull.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/ubuntu/dotfiles/agents/scheduler/pico-backup-pull.sh

# NOTE THE ABSENCE, exactly as in vs14d-backup-health.service: there is no
# `SuccessExitStatus=0 10`. Exit 10 here means "pico's state is not off pico's
# disk", which must NOT read as a successful run. Without this absence the unit
# is green while the backup does not exist — the failure mode the whole script
# was written against.

# 245 MB of sqlite snapshot plus the dumps, over the tailnet. A first run with a
# cold destination is the slow one; after that rsync moves deltas. Half an hour
# is generous on purpose — a pull that is merely slow must not be recorded as a
# pull that failed.
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true

# NO ProtectSystem / ProtectHome / PrivateTmp — measured, not an oversight
# (2026-07-26, recorded in vs14d-backup-health.service). Any of the three puts a
# systemd USER unit in a mount namespace backed by an unprivileged user
# namespace, where root-owned files map to `nobody`; OpenSSH then refuses to
# start with "Bad owner or permissions on
# /etc/ssh/ssh_config.d/20-systemd-ssh-proxy.conf". The failure is quiet in the
# worst way — the script still runs and still emits a verdict, and the verdict is
# `unreachable`, so a hardening directive would turn this into a permanent false
# alarm about a host that is fine. This unit opens an ssh connection AND drives
# rsync over it, so the whole set stays off. NoNewPrivileges needs no namespace,
# so it stays on.

[Install]
WantedBy=default.target
