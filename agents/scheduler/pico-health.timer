[Unit]
Description=pico health tick
Documentation=file:///home/ubuntu/dotfiles/agents/scheduler/pico-health.sh

[Timer]
# Every 30 minutes, OFF the round minute like everything else in the fleet — a
# watcher that fires at :00 lands in the same second as every cron-shaped job on
# both hosts, and its ssh then competes with whatever it is trying to observe.
#
# Why 30 minutes and not daily: the checks are cheap (one ssh round trip; the
# only expensive probe, `softwareupdate -l`, is rate-limited to once per 20h
# inside the script), and the conditions it watches — a gateway that stopped
# listening, a disk filling, an undocumented listener appearing — are ones where
# the gap between "it happened" and "someone knows" IS the damage. The nightly
# job failures that motivated this would have been caught by a daily check too;
# the port set and the front door would not.
OnCalendar=*-*-* *:07,37:00
RandomizedDelaySec=120

# Persistent: a missed tick means the thing watching for silence was itself
# silent. The probe is one ssh round trip, so an immediate catch-up is free.
Persistent=true
Unit=pico-health.service

[Install]
WantedBy=timers.target
