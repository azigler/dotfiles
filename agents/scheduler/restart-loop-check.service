[Unit]
Description=restart-loop check — supervised jobs stuck restarting forever, on both hosts
Documentation=file:///home/ubuntu/dotfiles/agents/bin/restart-loop-check.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/ubuntu/dotfiles/agents/bin/restart-loop-check.sh

# NOTE THE ABSENCE, same as vs14d-backup-health. There is deliberately no
# `SuccessExitStatus=0 10`. Exit 10 means "a job is looping forever", which must
# NOT read as a successful run — it makes this a FAILED unit, visible in
# `systemctl --user --failed`, a surface the fleet already reads.
#
# That is the whole point. The three loops this check exists for
# (dotfiles-wtrr) ran ~240,000 times each for two months, and the only witness
# was a counter nobody queried. Putting the finding somewhere nobody looks
# would reproduce the defect inside its own fix.

# Two ssh samples 15s apart plus per-label launchctl print across ~70 jobs.
TimeoutStartSec=300
Nice=10
NoNewPrivileges=true

# NO ProtectSystem / ProtectHome / PrivateTmp — measured 2026-07-26 on the
# sibling unit. Any of the three puts a systemd USER unit in a user namespace
# where root-owned files map to `nobody`, and OpenSSH then refuses to start
# ("Bad owner or permissions on /etc/ssh/ssh_config.d/..."). This unit ssh's to
# pico, so hardening it would turn it into a permanent false alarm about a host
# that is fine — the exact failure mode it is meant to catch.

[Install]
WantedBy=default.target
