[Unit]
Description=pico health — the keep's fail-closed watcher on the works (launchd, disk, state, patches, ports)
Documentation=file:///home/ubuntu/dotfiles/agents/scheduler/pico-health.sh
Documentation=file:///home/ubuntu/demesne/audits/works-audit-2026-08-09.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/dotfiles
ExecStart=/home/ubuntu/dotfiles/agents/scheduler/pico-health.sh

# NOTE THE ABSENCE, same as vs14d-backup-health and restart-loop-check. There is
# deliberately no `SuccessExitStatus=0 10`. Exit 10 means a real finding on pico
# — a scheduled job that failed, a disk filling, a frozen state document, an
# undocumented listener, an unpatched OS — and that must NOT read as a successful
# run. It makes this a FAILED unit, visible in `systemctl --user --failed`, a
# surface the fleet already reads.
#
# That is the whole point. Three com.zig.* jobs failed nightly for ~two months
# (works audit, 2026-08-09) and their only witness was the exit-code column of
# `launchctl list`. Putting this checker's finding somewhere nobody looks would
# reproduce the defect inside its own fix.
#
# Exit 1 (or any other non-zero) means THIS CHECKER is broken — an unwritable
# verdict ledger, a missing ports manifest, a probe that returned nothing. That
# is also a failed unit, and deliberately so: a watcher that cannot record its
# verdict is not a watcher.

# One ssh round trip; ~7s more on the once-a-day `softwareupdate -l`. If it has
# not answered in three minutes, the answer is no.
TimeoutStartSec=180
Nice=10
NoNewPrivileges=true

# NO ProtectSystem / ProtectHome / PrivateTmp — measured 2026-07-26 on the
# vs14d-backup-health unit, and the measurement is the reason this file looks
# under-hardened. Any of the three puts a systemd USER unit in a mount namespace
# backed by an unprivileged user namespace, where root-owned files map to
# `nobody`. OpenSSH then refuses to start:
#
#   Bad owner or permissions on /etc/ssh/ssh_config.d/20-systemd-ssh-proxy.conf
#
# The failure is quiet in the worst possible way: the checker still runs, still
# emits a verdict, and the verdict is `unreachable` — so a hardening directive
# would turn this into a permanent false alarm about a host that is fine, which
# is exactly the alarm fatigue that let the original silence last two months.
#
# What is lost is small: this process runs read-only commands on a remote host
# (`date`, `df`, `launchctl list`, `lsof`, `curl`, `softwareupdate -l`) and
# writes only its own verdict ledger under ~/.local/share/fleet-health/.
# NoNewPrivileges is the part that still applies without a namespace, so it stays.

[Install]
WantedBy=default.target
