[Unit]
Description=orphan-reaper daily sweep
Documentation=file:///home/ubuntu/dotfiles/agents/bin/orphan-reaper.sh

[Timer]
# Daily, not weekly like restart-loop-check.timer: the 2026-08-09 sweep found
# 42 processes at once, some only 6 days old and one ~57MB each — this leak
# accumulates fast enough that a week's worth is a meaningfully worse cleanup
# than a day's. Off-hour, off-minute like the rest of the fleet.
OnCalendar=*-*-* 05:17:00
RandomizedDelaySec=600

# Persistent: a missed tick means the thing sweeping leaked processes was
# itself silent for a day. Catch it up.
Persistent=true
Unit=orphan-reaper.service

[Install]
WantedBy=timers.target
