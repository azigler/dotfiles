100.72.47.4:6006   # phoenix UI
100.72.47.4:8080   # nginx — the vs14 front door
100.72.47.4:10000  # the harness PWA. Its LISTENING is checked here; the
#                    freshness of what it serves is check 3, which is the half
#                    that caught the 7-day-frozen state.json.
100.72.47.4:11434  # ollama (loopback does NOT reach it)
100.72.47.4:15000  # agentgateway admin UI

