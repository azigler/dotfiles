[Unit]
Description=gateway health — the keep probes the fleet's one door and re-opens it when it is shut
Documentation=file:///home/ubuntu/dotfiles/agents/scheduler/gateway-health.sh
Documentation=file:///home/ubuntu/dotfiles/agents/infra.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/dotfiles
ExecStart=/home/ubuntu/dotfiles/agents/scheduler/gateway-health.sh

# NOTE THE ABSENCE, same as pico-health and restart-loop-check. There is
# deliberately no `SuccessExitStatus=0 10`. Exit 10 means a real finding about
# the fleet's routing — the gateway was down, or is still down, or pico cannot
# be reached to fix it — and that must NOT read as a successful run. It makes
# this a FAILED unit, visible in `systemctl --user --failed`, a surface the
# fleet already reads.
#
# INCLUDING `restored`. A verdict of `restored` means this guard found the door
# shut, re-opened it, and proved it open again — and it still exits 10. A
# fleet-wide outage that had to be repaired by a timer is NEWS: it says pico's
# launchd lost the job, which is the 2026-08-09 shape (dotfiles-kviw) and will
# recur silently if a successful auto-repair is filed as a quiet success. The
# self-healing is so the fleet keeps working; the failed unit is so a human
# still learns it happened.
#
# Exit 1 (or any other non-zero) means THIS CHECKER is broken — an unwritable
# verdict ledger, a probe binary that will not execute. Also a failed unit, and
# deliberately so: a watcher that cannot record its verdict is not a watcher.

# One curl (8s cap) plus at most three ssh commands and two settle+re-probe
# rounds. If it has not answered in two minutes, the answer is no — and the next
# tick is 120 seconds away, so a hung run must never outlive its own cadence.
TimeoutStartSec=120
Nice=10
NoNewPrivileges=true

# NO ProtectSystem / ProtectHome / PrivateTmp — measured 2026-07-26 on the
# vs14d-backup-health unit and inherited here verbatim, because this unit ssh's
# too. Any of the three puts a systemd USER unit in a mount namespace backed by
# an unprivileged user namespace, where root-owned files map to `nobody`.
# OpenSSH then refuses to start:
#
#   Bad owner or permissions on /etc/ssh/ssh_config.d/20-systemd-ssh-proxy.conf
#
# The failure would be quiet in the worst possible way HERE: ssh dies, the guard
# reads that as `pico-unreachable`, and the one thing it exists to do — restart
# the gateway — silently never happens during the outage it was written for.

[Install]
WantedBy=default.target
