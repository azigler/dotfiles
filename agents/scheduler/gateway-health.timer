[Unit]
Description=gateway health tick
Documentation=file:///home/ubuntu/dotfiles/agents/scheduler/gateway-health.sh

[Timer]
# Every 2 minutes, on EVEN minutes at :11 seconds. Two things are load-bearing.
#
# The CADENCE: pico-health's 30 minutes is right for a disk filling or an
# unpatched OS, and hopelessly wrong for this. When the gateway is down, every
# seat on the fleet is down — the 2026-08-09 outage ran 12:36–15:08Z — so the
# gap between "it happened" and "it is fixed" IS the damage, measured in
# seat-hours. Two minutes bounds it. The probe is one 8s-capped curl on the
# healthy path (the overwhelmingly common one) and touches pico only when the
# door is already shut, so the cost of the tight loop is a request nobody notices.
#
# The PHASE: :11 seconds keeps it off the round minute, where every cron-shaped
# job on both hosts lands at once — and, more importantly, api-stall-recover
# runs on the ODD minutes at the same offset. That one minute of separation is
# the ordering the pair depends on: this guard restores the upstream, and only
# then does the other one nudge sessions back into it. Do not "tidy" the two
# timers onto the same schedule, and do not add RandomizedDelaySec — a random
# smear would let the recovery fire before the restore and nudge four sessions
# straight into a dead gateway.
OnCalendar=*-*-* *:0/2:11
RandomizedDelaySec=0
# AccuracySec pins the fire to the scheduled second. Without it systemd's
# DEFAULT is one full minute of coalescing smear — measured live on install
# day (fires at +1s, +2s, +19s) — which at the edge lets this fire land ON
# api-stall-recover's minute, collapsing the very ordering the comment above
# forbids re-timing away.
AccuracySec=1s

# NOT Persistent. On a 2-minute cadence a catch-up buys nothing — the next tick
# is at most 120 seconds out — and after a suspend or a long boot it would fire
# a burst of ssh at a pico that is very likely still coming up itself.
Persistent=false
Unit=gateway-health.service

[Install]
WantedBy=timers.target
