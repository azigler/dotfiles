# system
.DS_Store

# backup
.backup

# alacritty
catppuccin-macchiato.toml

# blightmud
blightmud/plugins

# fonts
fonts/SauceCodePro

# tmux
tmux/plugins/*
!tmux/plugins/.gitkeep

# vim
vim/autoload/plug.vim
vim/plugged
.netrwhist
viminfo

# zsh
zsh/.antigen
zsh/ohmyzsh

# cursor
.cursor

# ts4
ts4

# server addresses
.servers.bash_aliases

# secrets — machine-local, never committed (template: bash/.secrets.example)
.secrets

# node deps — installed trees are provisioned, never committed
node_modules/

# session state — created by agent-tier hooks, never committed
.offboard-pending
.claude/scheduled_tasks.lock
# /offboard Step 4 writes this; the skill states both markers are gitignored,
# but this one never was — it is a per-machine session id, not shared state.
.claude/last-offboard-session

# bv (beads viewer) local config and caches
.bv/

# bead store — migrated off the public tier (dotfiles-3mlp). What remains here
# is a machine-local symlink into the agent tier so `br` keeps working from
# this checkout; the store itself is private. Never track either form.
.beads
.beads.pre-3mlp-backup

# python bytecode from skill test runs
__pycache__/
*.pyc

# transient agent worktrees
.claude/worktrees/


# Seat working notes (Zig, 2026-08-10: the Works seat's offboard lands in this
# repo — its working home — but a handoff note carries operational detail the
# public tier must not track, per rule 5. Local file, never committed; the
# note's own header says where its history went.)
refs/
