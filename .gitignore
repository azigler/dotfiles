# node deps — installed trees are provisioned, never committed
node_modules/

# session state — created by agent-tier hooks, never committed
.offboard-pending
.claude/scheduled_tasks.lock
# /offboard Step 4 writes this; the skill states both markers are gitignored,
# but this one never was — it is a per-machine session id, not shared state.
.claude/last-offboard-session

# bv (beads viewer) local config and caches
.bv/

# python bytecode from skill test runs
__pycache__/
*.pyc

# transient agent worktrees
.claude/worktrees/

