# system
.DS_Store

# backup
.backup

# alacritty
catppuccin-macchiato.toml

# blightmud
blightmud/plugins

# fonts
fonts/SauceCodePro

# tmux
tmux/plugins/*
!tmux/plugins/.gitkeep

# vim
vim/autoload/plug.vim
vim/plugged
.netrwhist
viminfo

# zsh
zsh/.antigen
zsh/ohmyzsh

# cursor
.cursor

# ts4
ts4

# server addresses
.servers.bash_aliases

# secrets — machine-local, never committed (template: bash/.secrets.example)
.secrets

# node deps — skills carry their own manifest + lockfile (committed), but the
# installed tree is provisioned with `npm install`, never committed.
# (dotfiles-1ag: the /gdoc renderer resolves googleapis from its OWN
# agents/skills/gdoc/node_modules — not a global store, not a $HOME install.)
node_modules/

# session state — created by harness hooks, never committed
.offboard-pending
.claude/scheduled_tasks.lock

# bv (beads viewer) local config and caches
.bv/

archived/sandbox

# python bytecode from skill test runs
__pycache__/
*.pyc

# transient agent worktrees
.claude/worktrees/

# Ad-hoc gdoc scratch scripts — may hardcode doc IDs / SA key paths. Never commit.
# (render_styled_blocks.mjs IS tracked and load-bearing; it is re-added below.)
agents/skills/gdoc/*.mjs
!agents/skills/gdoc/render_styled_blocks.mjs
